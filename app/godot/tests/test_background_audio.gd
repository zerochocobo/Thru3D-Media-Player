	music.update_pointer("left_hand", Vector3.ZERO, seek_end.normalized(), true)
	music.refresh_values()
	check(music.has_pointer_capture() and absf(restored.position() - seek_before) < 0.5, "Timeline previews without repeatedly seeking during a drag")
	check(music._time.text == music._clock(restored.duration() * 0.75), "Timeline previews the target time")
	music.release_pointer("right_hand", Vector3.ZERO, seek_end.normalized(), true)
