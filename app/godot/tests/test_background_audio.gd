extends SceneTree
const Audio := preload("res://scripts/background_audio.gd")
const Music := preload("res://scripts/music_menu.gd")
const Photo := preload("res://scripts/photo_menu.gd")
const Library := preload("res://scripts/library_menu.gd")
const Main := preload("res://scripts/main.gd")
var failures: Array[String] = []
var checks := 0
var directory := ProjectSettings.globalize_path("res://../../build/output/background-audio/test-data").simplify_path()
class VideoStub extends Node3D:
	var local_uri := ""
	var view_camera: Camera3D
	var media := {"state": "playing"}
func _initialize() -> void: call_deferred("_run")
func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok: failures.append(message); push_error(message)
func settled(audio: Node) -> void:
	var end := Time.get_ticks_msec() + 15000
	while audio._thread != null and Time.get_ticks_msec() < end: await create_timer(0.01).timeout
	check(audio._thread == null, "Audio load settles")
func imported(audio: Node) -> void:
	var end := Time.get_ticks_msec() + 15000
	await process_frame
	while (audio.importer.busy or not audio.pending_imports.is_empty() or not audio._import_job.is_empty()) and Time.get_ticks_msec() < end: await create_timer(0.01).timeout
	check(not audio.importer.busy and audio.pending_imports.is_empty(), "Batch imports settle")
func button(menu: Node, id: int) -> Dictionary:
	for entry in menu._buttons:
		if entry.target == id: return entry
	return {}
func click(menu: Node, id: int) -> void:
	var entry := button(menu, id)
	check(not entry.is_empty() and entry.enabled, "Enabled ray target %d" % id)
	if entry.is_empty(): return
	var direction: Vector3 = entry.node.global_position.normalized()
	check(int(menu.ray_hit(Vector3.ZERO, direction).get("target", -999)) == id, "Ray reaches target %d" % id)
	menu.press_pointer("right_hand", Vector3.ZERO, direction, true)
	menu.release_pointer("right_hand", Vector3.ZERO, direction, true)
func _run() -> void:
	directory += "-%d" % Time.get_ticks_usec(); DirAccess.make_dir_recursive_absolute(directory)
	var audio := Audio.new(); audio.directory = directory; audio.importer.directory = directory.path_join("imports"); root.add_child(audio)
	check(audio.paused and audio.current.is_empty() and not audio.player.playing, "First launch is silent")
	check(audio.get_children().filter(func(node): return node is AudioStreamPlayer).size() == 1, "Only one application audio player exists")
	check(audio.library.all_tracks().size() == 12 and audio.library.all_playlists().size() == 4, "Six music tracks, six field recordings and four preset groups")
	for entry in audio.library.all_tracks():
		var stream: AudioStream = Audio.Catalog.load_audio(entry.path)
		check(stream != null and stream.get_length() > (170 if entry.get("kind") == "music" else 300), "Complete packaged asset: " + str(entry.id))
	check(audio.play_playlist("calm"), "Play calm playlist"); await settled(audio)
	check(audio.current == "yunhai" and audio.queue == ["yunhai", "xingmian"], "Playing playlist snapshots its queue")
	var first: AudioStream = audio.player.stream
	check(audio.play_playlist("ambience", "forest_wind"), "Select environment instead of music"); await settled(audio)
	check(audio.current == "forest_wind" and audio.player.stream != first and audio.mode == "single", "Environment replaces music and defaults to one-track repeat")
	check(audio.get_children().filter(func(node): return node is AudioStreamPlayer).size() == 1, "Switching categories never creates a second channel")
	audio._finished(); await settled(audio)
	check(audio.current == "forest_wind", "Environment does not jump to a different scene")
	audio.adjacent(1); await settled(audio); check(audio.current == "gentle_rain", "Manual next works in repeat-one mode")
	audio.set_context(true, true); check(audio.player.stream_paused and audio.blocked(), "Video suspends audio")
	audio.set_play_during_video(true)
	check(not audio.blocked() and not audio.player.stream_paused and audio.player.playing, "Opt-in keeps the actual built-in audio stream playing with video")
	var music_volume: float = audio.volume
	audio.set_volume(0); check(audio.player.volume_linear == 0 and audio.player.playing, "Music-only mute silences its stream without stopping playback")
	audio.set_volume(music_volume); audio.set_play_during_video(false)
	check(audio.player.stream_paused and audio.blocked() and not audio.paused, "Opt-out pauses the same stream without losing its play intent")
	audio.set_context(false, false); check(audio.blocked(), "Focus loss remains silent")
	audio.set_context(false, true); check(not audio.blocked(), "System suspension resumes previous intent")
	audio.toggle_pause(); audio.set_context(true, true); audio.set_context(false, true)
	check(audio.paused and audio.player.stream_paused, "Video return cannot override a manual pause")
	audio.toggle_pause()
	check(not audio.set_volume(NAN) and audio.set_volume(130) and audio.volume == 100, "One volume rejects nonfinite values and clamps")
	check(not audio.select_track("unknown") and audio.current == "gentle_rain", "Unknown IDs preserve playback")
	audio.select_track("xingmian"); audio.select_track("manyou"); await settled(audio)
	check(audio._loaded == "manyou", "Stale asynchronous loads never play an old choice")
	check(audio.seek(12.3), "Seek loaded music"); await create_timer(0.06).timeout
	check(absf(audio.position() - 12.3) < 1, "Seek updates the shared playhead")
	var own: String = audio.library.create_playlist("My panorama")
	var second: String = audio.library.create_playlist("Puzzle")
	check(not own.is_empty() and not second.is_empty(), "Create persistent playlists")
	check(audio.library.add_track(own, "yunhai") and audio.library.add_track(own, "ocean_waves"), "A playlist can reference music and environment sequentially")
	check(audio.library.add_track(own, "yunhai") and audio.library.playlist(own).tracks.size() == 2, "Playlist additions are deduplicated")
	check(audio.library.move_track(own, "ocean_waves", -1) and audio.library.playlist(own).tracks[0] == "ocean_waves", "Reorder playlist")
	check(audio.library.rename_playlist(own, "Panorama revised"), "Rename playlist")
	check(not audio.library.add_track("calm", "ocean_waves") and not audio.library.delete_playlist("calm"), "Preset playlists remain intact")
	audio.play_playlist(own); await settled(audio)
	var frozen := audio.queue.duplicate(); var before_edit: AudioStream = audio.player.stream
	audio.library.remove_track(own, "yunhai")
	check(audio.queue == frozen and audio.player.stream == before_edit, "Editing a saved playlist leaves the current queue and playback intact")
	audio.set_mode("list"); audio._finished(); await settled(audio)
	check(audio.current == "yunhai", "List repeat advances through the queue snapshot")
	audio.set_mode("shuffle")
	var previous: String = audio.current
	audio.adjacent(1); await settled(audio); check(audio.current != previous, "Shuffle avoids immediate repetition")
	audio.adjacent(-1); await settled(audio); check(audio.current == previous, "Shuffle previous follows actual playback history")
	print("Global audio phase: offline batch import")
	var wav := AudioStreamWAV.new(); wav.mix_rate = 22050; wav.format = AudioStreamWAV.FORMAT_16_BITS
	var data := PackedByteArray(); data.resize(22050 * 2 * 4)
	for i in 22050 * 4: data.encode_s16(i * 2, roundi(sin(float(i) * TAU * 220 / 22050) * 3000))
	wav.data = data
	var source := directory.path_join("source.wav"); check(wav.save_to_wav(source) == OK, "Generate real audio fixture")
	var source2 := directory.path_join("second.wav"); data.encode_s16(10, 123); wav.data = data; wav.save_to_wav(source2)
	var playing: String = audio.current; var playing_stream: AudioStream = audio.player.stream
	audio.import_tracks([{"uri": source, "title": "source.wav"}, {"uri": source2, "title": "second.wav"}], second); await imported(audio)
	check(audio.library.imports.size() == 2 and audio.library.playlist(second).tracks.size() == 2, "Complete batch is saved and appended in order")
	check(audio.library.resolve(audio.library.playlist(second).tracks[0]).label == "source.wav", "Batch preserves selection order")
	check(audio.current == playing and audio.player.stream == playing_stream, "Import never switches tracks or interrupts playback")
	var local_id: String = audio.library.imports[0].id; var copy_path: String = audio.library.imports[0].path
	audio.import_tracks([{"uri": source, "title": "same.wav"}], own); await imported(audio)
	check(audio.library.imports.size() == 2 and audio.library.playlist(own).tracks.has(local_id), "Import deduplication shares one copy across playlists")
	check(audio.library.references(local_id).size() == 2, "Deletion can identify affected playlists")
	audio.import_tracks([{ "uri": source, "title": "cancelled.wav"}, {"uri": source2, "title": "not-started.wav"}], second)
	audio.cancel_imports(); await imported(audio)
	check(audio.library.imports.size() == 2 and FileAccess.file_exists(copy_path), "Cancelling a batch never removes an existing deduplicated copy")
	audio.library.remove_track(own, local_id)
	check(FileAccess.file_exists(copy_path) and audio.library.resolve(local_id).size() > 0, "Removing from a playlist never deletes audio")
	DirAccess.remove_absolute(source); DirAccess.remove_absolute(source2)
	audio.play_playlist(second, local_id); await settled(audio)
	check(audio._loaded == local_id and FileAccess.file_exists(copy_path), "Local copy plays after all original sources disappear")
	audio.set_mode("single"); var repeat_stream: AudioStream = audio.player.stream
	audio.seek(3.90); await create_timer(0.3).timeout; await settled(audio)
	check(audio.current == local_id and audio.player.playing and audio.position() < 1 and audio.player.stream == repeat_stream, "Real EOF repeats using the same stream without loading a second player")
	audio.set_mode("list"); audio.seek(3.90); await create_timer(0.3).timeout; await settled(audio)
	check(audio.current != local_id, "Real EOF advances to the next queued track")
	var last_id: String = audio.current
	audio.set_mode("sequence"); audio.seek(3.90); await create_timer(0.3).timeout; await settled(audio)
	check(audio.current == last_id and audio.paused and not audio.player.playing and absf(audio.position() - audio.duration()) < 0.02, "Sequential real EOF stops at the last track and retains the end position")
	check(not audio.can_advance(1) and not audio.adjacent(1) and audio.paused, "Sequential manual next cannot wrap at the end")
	var ended_config := ConfigFile.new(); audio.save_settings(ended_config)
	var ended := Audio.new(); ended.load_settings(ended_config)
	check(ended.mode == "sequence" and ended.paused and ended._queue_finished, "Completed sequential queue restores silently with its repeat preference")
	ended.importer.free(); ended.free()
	audio.toggle_pause(); await settled(audio)
	check(audio.current == local_id and not audio.paused and audio.position() < 1, "Play after sequential completion restarts the queue")
	audio.play_tracks([local_id], local_id); await settled(audio)
	audio.seek(3.90); await create_timer(0.3).timeout
	check(audio.paused and not audio.player.playing, "A one-track sequential queue stops instead of repeating")
	check(audio.seek(1.0) and audio.paused, "Seeking a completed track preserves pause intent")
	audio.toggle_pause(); await create_timer(0.05).timeout
	check(audio.player.playing and audio.position() >= 1 and audio.position() < 2, "Play after seeking a completed track resumes from the new position")
	audio.set_mode("list"); audio.seek(3.90); await create_timer(0.3).timeout
	check(not audio.paused and audio.player.playing and audio.position() < 1, "One-track list repeat still loops")
	audio.set_mode("single"); audio.play_playlist("calm"); await settled(audio)
	check(audio.mode == "single", "Selecting another playlist preserves the chosen mode")
	audio.set_mode("sequence"); audio.play_playlist(second); await settled(audio)
	check(audio.mode == "sequence", "Selecting another track list preserves sequential mode")
	audio._finished(); await settled(audio)
	check(audio.current == last_id and not audio.paused, "Sequential EOF advances to the next track before the queue ends")
	audio.set_context(true, true); audio._finished()
	check(audio._end_pending and not audio.paused, "An EOF during suspension waits for the playback context")
	audio.set_context(false, true)
	check(audio.paused and audio._queue_finished and not audio.player.playing, "Resuming a suspended final EOF stops sequential playback without wrapping")
	audio.set_mode("list"); audio.select_track(last_id); await settled(audio); audio._finished(); await settled(audio)
	check(audio.current == local_id, "List repeat wraps the final track to the start")
	audio.set_mode("sequence")
	audio.select_track(local_id); await settled(audio)
	audio.seek(1.2); audio.toggle_pause()
	var config := ConfigFile.new(); audio.save_settings(config)
	check(config.get_value("audio_player", "current") == local_id and not config.has_section_key("background_audio", "music"), "Unified state replaces the dual-channel preferences")
	var restored := Audio.new(); restored.directory = directory; restored.importer.directory = directory.path_join("imports"); restored.load_settings(config); root.add_child(restored)
	check(restored.current == local_id and restored.paused and restored.player.stream == null, "Restart restores selection silently without decoding")
	check(absf(restored.position() - 1.2) < 0.15, "Restart remembers playhead")
	check(absf(restored.duration() - 4) < 0.15, "Silent restore can show the saved duration before decoding")
	restored.toggle_pause(); await settled(restored)
	check(restored._loaded == local_id and not restored.blocked(), "Explicit play after restart uses only saved local copy")
	check(restored.library.playlist(own).label == "Panorama revised", "Playlist edits persist across restart")
	restored.toggle_pause()
	audio.import_tracks([{"uri": directory.path_join("missing.wav"), "title": "missing.wav"}], second); await imported(audio)
	check(audio.failed_imports.size() == 1 and not audio.library.playlist(second).tracks.has("missing"), "Failed imports do not publish a playable item")
	check(audio.current == local_id and audio.paused, "Import failure preserves manual pause")
	wav.save_to_wav(directory.path_join("missing.wav")); audio.retry_imports(); await imported(audio)
	check(audio.failed_imports.is_empty() and audio.current == local_id and audio.paused, "Retrying a failed source saves it without overriding pause")
	var old_label: String = audio.library.playlist(own).label
	var blocker := directory.path_join("cannot-create-directory"); var blocked_file := FileAccess.open(blocker, FileAccess.WRITE); blocked_file.store_string("fixture"); blocked_file.close()
	audio.library.directory = blocker
	check(not audio.library.rename_playlist(own, "Unsaved") and audio.library.playlist(own).label == old_label, "A failed metadata save preserves the previous playlist")
	audio.library.directory = directory; audio.library.error = ""
	check(not restored.importer.remove_copy(directory.path_join("outside.wav")), "Local deletion is confined to the app import directory")
	check(restored.remove_import(local_id), "Delete a local audio file explicitly")
	check(not FileAccess.file_exists(copy_path) and restored.current.is_empty() and not restored.library.playlist(second).tracks.has(local_id), "Deletion clears active item and all references")
	check(restored.library.delete_playlist(second) and restored.library.imports.size() == 1, "Deleting a playlist retains its other files")
	var legacy := ConfigFile.new(); legacy.set_value("background_audio", "music", "yunhai"); legacy.set_value("background_audio", "ambience", "ocean_waves")
	var migrated := Audio.new(); migrated.directory = directory.path_join("migration"); migrated.load_settings(legacy); root.add_child(migrated)
	check(migrated.queue == ["yunhai", "ocean_waves"] and migrated.paused and not migrated.player.playing, "Legacy two-channel choices migrate as a silent sequential queue")
	# More than 32 real files exercise the former global import cap without large fixtures.
	var bulk := Audio.new(); bulk.directory = directory.path_join("bulk"); bulk.importer.directory = bulk.directory.path_join("imports"); root.add_child(bulk)
	var files: Array = []; var tiny := AudioStreamWAV.new(); tiny.mix_rate = 8000; tiny.format = AudioStreamWAV.FORMAT_16_BITS
	for i in 33:
		var samples := PackedByteArray(); samples.resize(1600); samples.encode_s16(10, i + 1); tiny.data = samples
		var path := directory.path_join("bulk-%02d.wav" % i); tiny.save_to_wav(path); files.append({"uri": path, "title": path.get_file()})
	bulk.import_tracks(files); await imported(bulk)
	check(bulk.library.imports.size() == 33 and bulk.paused and bulk.current.is_empty(), "Global audio library accepts more than 32 imports and remains silent")
	var reloaded := Audio.Library.new(); reloaded.directory = bulk.directory; reloaded.load_library()
	check(reloaded.imports.size() == 33, "All imports beyond the old cap survive restart")
	print("Global audio phase: entry points and ray menus")
	var music := Music.new(); music.audio = restored; root.add_child(music); music.open(false)
	check(music.compact, "Home entry starts with compact now playing")
	click(music, Music.QUEUE); click(music, Music.TAB)
	check(button(music, Music.NEW_LIST).size() > 0, "Full player offers playlist creation")
	click(music, Music.ROW)
	check(music.view == "tracks" and music.playlist_id == "calm", "Ray opens a preset playlist")
	click(music, Music.ROW); await settled(restored)
	check(restored.current == "yunhai", "Ray selects a song in the shared transport")
	music.open(true)
