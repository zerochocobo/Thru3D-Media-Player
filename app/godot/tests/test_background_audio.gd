	for expected in ["list", "single", "shuffle", "sequence"]:
		click(music, Music.MODE); check(restored.mode == expected, "Compact ray mode switch: " + expected)
	var seek_slider: Dictionary = music.choices.sliders.values()[0]
	var seek_start: Vector3 = seek_slider.node.to_global(Vector3(seek_slider.left + seek_slider.width * 0.25, 0, 0))
	var seek_end: Vector3 = seek_slider.node.to_global(Vector3(seek_slider.left + seek_slider.width * 0.75, 0, 0))
	var seek_before: float = restored.position()
