extends SceneTree
const Menu := preload("res://scripts/library_menu.gd")
const Fixture := preload("res://tests/test_web_browser_panel.gd")
const Home := preload("res://scripts/web_video_home.gd")
const Sites := preload("res://scripts/web_video_sites.gd")
const I18n := preload("res://scripts/i18n.gd")
var failures: Array[String] = []
var checks := 0
func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok: failures.append(message)
func _initialize() -> void: call_deferred("_run")
func _run() -> void:
	for locale in ["zh", "zh_Hant", "zh-CN", "zh-TW"]:
		check(Sites.ordered_indexes(locale).slice(0, 8) == [0, 1, 2, 3, 4, 5, 17, 18], "Chinese sites and YouTube lead for " + locale)
	for locale in ["en", "ja", "ko"]:
		check(Sites.ordered_indexes(locale).slice(-7) == [0, 2, 3, 4, 5, 17, 18], "International sites lead for " + locale)
	check(Sites.ordered_indexes("ja").slice(0, 2) == [1, 16], "YouTube and Niconico lead for Japanese")
	var future := [{"languages": ["zh"]}, {"languages": []}, {"languages": ["ja"]}, {"languages": ["ko"]}]
	check(Sites.ordered_indexes("ja-JP", future) == [2, 1, 3, 0], "Japanese audience sites precede international and Chinese sites")
	check(Sites.ordered_indexes("ko-KR", future) == [3, 1, 2, 0], "Korean audience sites precede international and Chinese sites")
	I18n.use("zh")
	var menu := Menu.new(); root.add_child(menu)
	var platform := Fixture.Platform.new(); menu.attach_platform(platform); menu.toggle()
	menu._activate(Menu.NAV_BASE + Menu.Section.WEB)
	check(menu.web_video.home.active(), "Browser section presents home")
	var frame: Array = menu.web_video.home.backdrop()
	check(frame[0].is_equal_approx(Vector2(1.46, 1.12)) and is_zero_approx(frame[1].y), "Expanded browser home shares the navigation panel height and centre")
	menu.web_browser.tick()
	var resume: Node = menu._buttons.filter(func(button): return button.target == Home.BASE + 2)[0].node
	var captions: Array = resume.get_children().filter(func(node): return node is Label3D).map(func(node): return node.text)
	var shown: Array = captions.filter(func(text): return not text.is_empty())
	check(shown.size() == 1 and shown[0].contains("Video"), "Continue shows the destination title on one compact line")
	check(menu._tips.get(Home.BASE + 2) == platform.browser.url, "Continue hover exposes the exact destination")
	check(menu._buttons.any(func(b): return b.target == Home.SITE_BASE), "Featured links start expanded with ray targets")
	var first_cards := menu._buttons.filter(func(b): return b.target >= Home.SITE_BASE and b.target < Home.SITE_BASE + Sites.FEATURED.size())
	check(first_cards.size() == 15, "Compact featured page holds fifteen sites")
	for card in first_cards:
		var site: Dictionary = Sites.FEATURED[card.target - Home.SITE_BASE]
		check(card.node.has_node("PlayBetaBadge") == Sites.supports_beta(site), "Only catalogue-approved sites show the Beta triangle: " + site.name)
		check(card.node.has_node("NativePlaybackBadge") == (Sites.supports_native(site) and not Sites.supports_beta(site)), "Other supported sites retain their original badge: " + site.name)
		var labels: Array = card.node.get_children().filter(func(node): return node is Label3D and not node.text.is_empty())
		check(labels.size() == 1 and is_zero_approx(labels[0].position.y) and labels[0].horizontal_alignment == HORIZONTAL_ALIGNMENT_LEFT, "Site name sits beside the icon")
		check(menu._tips[card.target] == I18n.t(site.name) + "\n" + (I18n.t("Play in player (Beta)") if Sites.supports_beta(site) else I18n.t(Home.NATIVE_TIP) if Sites.supports_native(site) else str(site.url)), "Hover describes the correct playback path or site address")
	check(not Sites.supports_beta(Sites.FEATURED[17]) and Sites.supports_native(Sites.FEATURED[17]), "iQIYI local-only Beta does not earn a catalogue badge or remove its original entry")
	check(not Sites.supports_beta(Sites.FEATURED[5]) and Sites.supports_native(Sites.FEATURED[5]), "Youku incomplete current device acceptance does not earn a catalogue Beta badge")
	check(Sites.supports_beta(Sites.FEATURED[16]), "Niconico ordinary homepage selection and retained-return device evidence earns its Beta badge")
	check(not Sites.supports_beta(Sites.FEATURED[12]) and not Sites.supports_beta_url("https://clips.twitch.tv/PublicClip"), "Twitch clip support does not advertise the whole site")
	check(not Sites.beta_replaces_legacy_url("https://clips.twitch.tv/PublicClip") and not Sites.supports_beta_url("https://clips.twitch.tv.evil/PublicClip"), "Twitch keeps legacy playback and requires its trusted host")
	check(Sites.supports_beta(Sites.FEATURED[13]) and not Sites.supports_beta_url("https://www.tiktok.com/@test/video/6742501081818877190"), "TikTok Featured feed device acceptance earns its catalogue badge while page actions remain current-video bound")
	check(not Sites.beta_replaces_legacy_url("https://www.tiktok.com/@test/video/6742501081818877190") and not Sites.supports_beta_url("https://www.tiktok.com.evil/video/6742501081818877190"), "TikTok keeps the original manual action and requires its trusted host")
	check(not Sites.supports_beta(Sites.FEATURED[15]) and not Sites.supports_beta_url("https://www.ted.com/talks/current_talk"), "TED relies on current native adapter availability instead of a domain promise")
	check(not Sites.beta_replaces_legacy_url("https://www.ted.com/talks/current_talk") and not Sites.supports_beta_url("https://www.ted.com.evil/talks/current_talk"), "TED keeps its original manual action and requires the trusted host")
	check(Sites.supports_beta(Sites.FEATURED[14]) and not Sites.supports_beta_url("https://www.instagram.com/reel/Chunk8-jurw/"), "Instagram Featured Reels next-video device acceptance earns its catalogue badge")
	check(not Sites.beta_replaces_legacy_url("https://www.instagram.com/reel/Chunk8-jurw/") and not Sites.supports_beta_url("https://www.instagram.com.evil/reel/Chunk8-jurw/"), "Instagram retains its manual action and requires the trusted host")
	check(Sites.FEATURED[19].name == "Dailymotion" and not Sites.supports_beta(Sites.FEATURED[19]), "Dailymotion keeps its featured entry without a premature whole-site Beta badge")
	check(Sites.FEATURED[19].icon == "site_dailymotion" and not Sites.supports_beta_url("https://www.dailymotion.com/video/x5kesuj"), "Dailymotion keeps its icon and requires real native availability")
	check(not Sites.beta_replaces_legacy_url("https://www.dailymotion.com/video/x5kesuj") and not Sites.supports_beta_url("https://www.dailymotion.com.evil/video/x5kesuj"), "Dailymotion retains the old manual action and cannot trust a lookalike host")
	check(Sites.FEATURED[20].name == "Streamable" and not Sites.supports_beta(Sites.FEATURED[20]), "Streamable keeps its featured entry without claiming its upload homepage can play")
	check(Sites.FEATURED[20].icon == "site_streamable" and not Sites.supports_beta_url("https://streamable.com/abc123"), "Streamable keeps its icon and requires real native availability")
	check(not Sites.beta_replaces_legacy_url("https://streamable.com/abc123") and not Sites.supports_beta_url("https://streamable.com.evil/abc123"), "Streamable keeps its manual action and rejects a lookalike host")
	check(Sites.FEATURED[21].name == "Internet Archive" and Sites.supports_beta(Sites.FEATURED[21]), "Archive Featured collection-to-film device acceptance earns its Beta badge")
	check(Sites.FEATURED[21].icon == "site_archive" and not Sites.supports_beta_url("https://archive.org/details/PublicFilm"), "Archive keeps its icon and requires real native availability")
	check(not Sites.beta_replaces_legacy_url("https://archive.org/details/PublicFilm") and not Sites.supports_beta_url("https://archive.org.evil/details/PublicFilm"), "Archive keeps manual playback and rejects lookalike hosts")
	check(Sites.FEATURED[22].name == "Odysee" and not Sites.supports_beta(Sites.FEATURED[22]), "Odysee keeps its featured entry without expanding a fixed sample into a catalogue badge")
	check(Sites.FEATURED[22].icon == "site_odysee" and not Sites.supports_beta_url("https://odysee.com/@Public:1/PublicClip:1"), "Odysee keeps its icon and requires real native availability")
	check(not Sites.beta_replaces_legacy_url("https://odysee.com/@Public:1/PublicClip:1") and not Sites.supports_beta_url("https://odysee.com.evil/@Public:1/PublicClip:1"), "Odysee keeps manual playback and rejects lookalike hosts")
	check(not Sites.supports_beta_url("https://www.nicovideo.jp/watch/sm9") and not Sites.supports_beta_url("https://www.nicovideo.jp.evil.test/watch/sm9"), "Niconico does not show Beta solely because a URL matches its domain")
	check(Sites.supports_beta(Sites.FEATURED[18]) and Sites.supports_native(Sites.FEATURED[18]), "Douyin uses the verified Beta badge and playback path")
	check(Sites.supports_beta_url("https://www.douyin.com/") and not Sites.supports_beta_url("https://www.douyin.com.evil.test/"), "Douyin Beta presentation accepts only the trusted main host")
	menu._activate(Home.SITE_BASE + 18)
	check(menu.web_browser.opened and platform.browser.url == "https://www.douyin.com/", "Douyin card opens its website")
	menu.web_browser.close(); menu.refresh()
	menu._activate(Home.BASE + 5)
	check(not menu._buttons.any(func(b): return b.target >= Home.SITE_BASE and b.target < Home.SITE_BASE + 100), "Folding hides the featured links")
	menu._activate(Home.BASE + 5)
	check(menu._buttons.any(func(b): return b.target == Home.SITE_BASE), "Expanding exposes ray targets")
	I18n.use("en"); menu.refresh()
	var cards := menu._buttons.filter(func(b): return b.target >= Home.SITE_BASE and b.target < Home.SITE_BASE + 100)
	check(cards[0].target == Home.SITE_BASE + 1, "Changing UI language reorders visible cards")
	menu._activate(cards[0].target)
	check(platform.browser.url == "https://www.youtube.com/", "Reordered first icon opens its own site")
	menu.web_browser.close(); menu.refresh()
	menu._activate(Home.BASE + 7)
	check(menu.web_video.home.site_page == 1 and menu.web_video.home.visible_sites().size() <= Home.PAGE_SIZE, "Extra sites stay on a second bounded page")
	menu._activate(Home.SITE_BASE + 1)
	check(not menu.web_browser.opened, "An icon from the previous page cannot navigate")
	var second_page: Array = menu.web_video.home.visible_sites()
	menu._activate(Home.SITE_BASE + second_page[0])
	check(platform.browser.url == Sites.FEATURED[second_page[0]].url, "Second page icon opens its own URL")
	menu.web_browser.close(); I18n.use("zh"); menu.refresh()
	check(menu.web_video.home.site_page == 0, "Language changes return to the first page")
	menu._activate(Home.BASE + 5)
	menu._activate(Home.SITE_BASE)
	check(not menu.web_browser.opened, "Hidden site targets cannot navigate")
	menu._activate(Home.BASE + 5); menu._activate(Home.SITE_BASE)
	check(menu.web_browser.opened and platform.browser.url == "https://www.bilibili.com/", "Featured icon opens the site")
	check(not menu.web_video.home.action(Home.BASE + 5), "Home does not consume browser controls")
	menu.web_browser.close(); menu.refresh()
	menu.web_video.home._open("https://example.com/")
	check(platform.browser.url == "https://example.com/", "Address submit opens browser")
	menu.free(); platform.free()
	print("Web video home: %d checks, %d failures" % [checks, failures.size()])
	for failure in failures: push_error(failure)
	quit(0 if failures.is_empty() else 1)
