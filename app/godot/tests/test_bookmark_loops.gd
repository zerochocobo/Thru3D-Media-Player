extends SceneTree
const Store := preload("res://scripts/bookmark_store.gd")
const Video := preload("res://scripts/mpv_video_display.gd")
const Menu := preload("res://scripts/player_menu.gd")
const Desktop := preload("res://scripts/environments/cinema_desktop_video.gd")
var checks := 0
var failures: Array[String] = []

class FailedWrite extends Store:
	func _commit(_staged: String, _target: String) -> Error: return ERR_CANT_CREATE

class Host extends RefCounted:
	var requests: Array = []
	func close_mpv_video(_id: int) -> void: pass
	func set_mpv_playing(_id: int, _playing: bool) -> void: pass
	func revise_mpv_video(_id: int, _stereo: bool, _alpha: bool, _profile: String, time: int, _depth: bool, _top_bottom: bool, exact: bool = false) -> int:
		requests.append([time, exact]); return 100 + requests.size()

func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok: failures.append(message)

func origin(menu: Node3D, target: int) -> Vector3:
	for button in menu._buttons:
		if button.target == target: return menu.to_global(Vector3(button.rect.get_center().x, button.rect.get_center().y, 1))
	return Vector3.ZERO

func tap(menu: Node3D, target: int) -> void:
	var start := origin(menu, target)
	check(start != Vector3.ZERO, "Control exists: " + str(target))
	menu.press_pointer("left_hand", start, -menu.global_basis.z, true)
	menu.release_pointer("left_hand", start, -menu.global_basis.z, true)

func landed(video: Node3D, position: int, playing: bool = true) -> void:
	video._waiting_first = false; video._pending_revision.clear()
	video.control.first_frame(position); video.control.observe(position, 120000)
	video.media.state = "playing" if playing else "paused"; video.requested_play = playing
	video.media.playback = {"details": {"seekable": "yes", "partially_seekable": "no"}}

func _initialize() -> void: call_deferred("run")

func run() -> void:
	preload("res://scripts/i18n.gd").use("en")
	var desktop := Desktop.new()
	check(desktop is Video, "Experimental desktop subclass retains a compatible seek signature")
	desktop.free()
	var path := ProjectSettings.globalize_path("res://../../build/output/bookmark-loops/store-" + str(Time.get_ticks_usec()))
	var store := Store.new(path)
	var uri := "file:///loop-test.mp4"
	var id := store.resolve(uri, "loop-test.mp4", 5000)
	var a := store.add(uri, "loop-test.mp4", 5000, 10000)
	var b := store.add(uri, "loop-test.mp4", 5000, 30000)
	var c := store.add(uri, "loop-test.mp4", 5000, 50000)
	var first := store.save_loop(id, a.id, b.id)
	check(not first.is_empty() and store.list_loops(id)[0].a_ms == 10000, "Create a fixed range")
	var inserted := store.add(uri, "loop-test.mp4", 5000, 20000)
	check(store.list_loops(id)[0].a == a.id and store.list_loops(id)[0].b == b.id, "Insertion never retargets saved endpoints")
	check(store.save_loop(id, a.id, b.id).id == first.id and store.list_loops(id).size() == 1, "Duplicate creation reuses existing range")
	check(store.save_loop(id, b.id, a.id).is_empty() and store.save_loop(id, a.id, a.id).is_empty(), "Reversed and zero ranges rejected")
	var near := store.add(uri, "loop-test.mp4", 5000, 11500)
	check(store.save_loop(id, a.id, near.id).is_empty(), "Sub-two-second loop rejected")
	check(store.save_loop(id, "missing", b.id).is_empty(), "Dangling endpoint rejected")
	var second := store.save_loop(id, b.id, c.id)
	check(store.list_loops(id).size() == 2, "Adjacent segments may share B/A boundary")
	check(store.save_loop(id, a.id, c.id).is_empty() and store.last_error == "Start bookmark already used" and store.list_loops(id).size() == 2, "One A cannot create a second B")
	check(store.save_loop(id, a.id, c.id, second.id).is_empty() and store.list_loops(id).size() == 2, "Editing cannot borrow another segment's A")
	check(Store.new(path).list_loops(id) == store.list_loops(id), "Segments survive restart")
	check(store.save_loop(id, inserted.id, b.id, first.id).id == first.id and store.list_markers(id)[0].position_ms == 10000, "Editing range references never moves markers")
	var failed := FailedWrite.new(path)
	var before := failed.list_loops(id)
	check(not failed.remove(id, b.id) and failed.list_loops(id) == before and not failed.can_undo(), "Failed endpoint deletion changes neither points nor ranges")
	check(failed.save_loop(id, a.id, c.id).is_empty() and failed.list_loops(id) == before, "Failed creation stays atomic")
	check(store.remove(id, b.id) and store.list_loops(id).is_empty(), "Deleting shared endpoint removes every referencing range")
	check(store.restore() and store.list_loops(id).size() == 2 and Store.new(path).list_loops(id).size() == 2, "Undo atomically restores endpoint and both ranges to disk")
	var points := store.list_markers(id)
	check(store.remove_loop(id, second.id) and store.list_markers(id) == points, "Deleting a range preserves ordinary bookmarks")
	check(store.restore() and store.list_loops(id).size() == 2, "Range deletion has undo")
	store.remove_loop(id, first.id)
	store.save_loop(id, inserted.id, c.id)
	var conflict := store.list_loops(id)
	check(not store.restore() and store.list_loops(id) == conflict, "Undo cannot reintroduce a shared A with a different B")
	var old_path := path.path_join("v1")
	DirAccess.make_dir_recursive_absolute(old_path)
	var legacy := {"id": id, "sequence": 1, "aliases": [Store.Memory.key_for(uri)], "fingerprint": Store.fingerprint("loop-test.mp4", 5000), "markers": [a, b]}
	var payload := JSON.stringify(legacy)
	var file := FileAccess.open(old_path.path_join(id + "_1.json"), FileAccess.WRITE)
	file.store_string(JSON.stringify({"schema_version": 1, "payload_json": payload, "payload_sha256": payload.sha256_text()})); file.close()
	var old := Store.new(old_path)
	check(old.list_markers(id).size() == 2 and old.list_loops(id).is_empty(), "Version 1 loads without inventing loops")
	check(not old.save_loop(id, a.id, b.id).is_empty() and Store.new(old_path).list_loops(id).size() == 1, "Version 1 upgrades on first actual mutation")
	var bad: Dictionary = old.records[id].duplicate(true); bad.loops[0].a = "missing"
	check(not old._save(bad) and Store.new(old_path).list_loops(id).size() == 1, "Malformed range cannot replace valid bank")
	var moved := "file:///renamed/loop-test.mp4"
	check(old.relocate(uri, moved, "loop-test.mp4", 5000) and old.list_loops(old.resolve(moved)).size() == 1 and old.list_loops(id).is_empty(), "Relocation transfers ranges with points and clears old record")

	var video := Video.new(); video.bookmark_store = Store.new(path.path_join("player"))
	root.add_child(video); video.set_process(false)
	video.media.begin(7); video.media.state = "paused"
	video.control.duration_ms = 120000; video.local_uri = uri
	video._bookmark_metadata = {"basename": "loop-test.mp4", "size": 5000}; video._bookmark_resolve()
	var vid: String = video._bookmark_media_id
	a = video.bookmark_store.add(uri, "loop-test.mp4", 5000, 10000)
	b = video.bookmark_store.add(uri, "loop-test.mp4", 5000, 30000)
	c = video.bookmark_store.add(uri, "loop-test.mp4", 5000, 50000)
	first = video.bookmark_store.save_loop(vid, a.id, b.id)
	second = video.bookmark_store.save_loop(vid, b.id, c.id)
	var host := Host.new(); video.platform = host
	landed(video, 5000, false)
	var scope: String = video.bookmark_scope()
	landed(video, 10000); video.bookmark_loop.tick()
	landed(video, 30000); video.bookmark_loop.tick()
	landed(video, 50000); video.bookmark_loop.tick()
	check(not video.bookmark_loop.active and host.requests.is_empty(), "Natural playback across all saved endpoints never activates or seeks")
	check(video.bookmark_loop.action("save", {"a": a.id, "b": b.id}, scope) == "Loop saved" and not video.bookmark_loop.active and host.requests.is_empty(), "Saving a segment never seeks or enables it")
	landed(video, 5000, false)
	check(video.bookmark_loop.action("toggle", {"id": first.id}, scope) == "Loop enabled" and not video.requested_play, "Activation preserves pause intent")
	check(host.requests == [[10000, true]], "Activation uses exact production revision chain")
	for index in 10: video.bookmark_loop.tick()
	check(host.requests.size() == 1, "Pending landing cannot repeatedly seek")
	landed(video, 10000, false); video.bookmark_loop.tick()
	video.control.observe(30000, 120000); video.bookmark_loop.tick()
	check(host.requests.size() == 1 and video.bookmark_loop.active, "Paused boundary keeps loop without jumping")
	video.requested_play = true; video.bookmark_loop.tick()
	check(host.requests.size() == 2 and host.requests.back() == [10000, true], "Confirmed B returns to A exactly once")
	landed(video, 10000); video.bookmark_loop.tick()
	video.seek_absolute(20000, "speed")
	check(video.bookmark_loop.active and host.requests.back() == [20000, true], "Manual seek inside keeps loop and exact precision")
	landed(video, 20000); video.bookmark_loop.tick()
	video.seek_relative(15000)
	check(not video.bookmark_loop.active and host.requests.back() == [35000, false], "Relative seek outside exits loop and retains global speed mode")
	landed(video, 35000)
	video.bookmark_loop.start(first.id); landed(video, 10000); video.bookmark_loop.tick()
	video.bookmark_loop.start(second.id)
	check(video.bookmark_loop.selected == second.id and host.requests.back()[0] == 30000, "Only one range activates when switching")
	landed(video, 30000); video.bookmark_loop.tick()
	var request_count := host.requests.size()
	video.bookmark_loop.action("toggle", {"id": second.id}, scope)
	check(not video.bookmark_loop.active and host.requests.size() == request_count, "Disabling continues at current position without seeking")
	video.bookmark_loop.start(first.id); landed(video, 30000); video.bookmark_loop.tick()
	check(not video.bookmark_loop.active, "Invalid landing disables loop instead of seeking forever")
	video.bookmark_loop.start(first.id); landed(video, 10000); video.bookmark_loop.tick()
	video.control.observe(30000, 120000); video._binding.ticket = {"frozen_frame_id": 1}
	request_count = host.requests.size(); video.bookmark_loop.tick()
	check(host.requests.size() == request_count, "Frozen frame cannot trigger a loop jump")
	video._binding.ticket.clear()
	video.media.state = "failed"; video.bookmark_loop.tick()
	check(not video.bookmark_loop.active, "Playback failure clears active loop")
	landed(video, 10000)
	check(video.bookmark_loop.action("toggle", {"id": first.id}, "stale").is_empty() and not video.bookmark_loop.active, "Stale media scope cannot start a loop")
	video.bookmark_loop.start(first.id); landed(video, 10000); video.bookmark_loop.tick()
	var completed: Array = []
	video.playback_completed.connect(func(): completed.append(true))
	video.media.state = "ended"
	video.media.last_pair = {"slot_token": 9, "source_epoch": 7, "frame_id": 179, "pts_us": 119990000}
	video.media.playback = {"eof_source_resolved": true, "eof_pair_post_draw": true, "eof_presented_slot": 9, "eof_source_ticket": {"source_epoch": 7, "frame_id": 179, "pts_us": 119990000}}
	video.loop_enabled = true; request_count = host.requests.size()
	video._process_playback_end()
	check(host.requests.size() == request_count and completed.is_empty(), "A-B takes priority over full-file repeat and playlist EOF")
	video.bookmark_loop.tick()
	check(host.requests.size() == request_count + 1 and host.requests.back()[0] == 10000 and video.loop_enabled, "EOF returns to A without changing original play mode")
	landed(video, 10000); video.bookmark_loop.tick()
	video.bookmark_action("delete", b.id, scope); video.bookmarks_snapshot()
	check(not video.bookmark_loop.active and video.bookmark_loop.segments.is_empty(), "Deleting active endpoint stops loop immediately")
	video.bookmark_action("undo", "", scope); video.bookmarks_snapshot()
	check(not video.bookmark_loop.active and video.bookmark_loop.segments.size() == 2, "Undo restores definitions without restarting playback")

	var menu := Menu.new()
	menu.state_provider = func():
		var state: Dictionary = video.bookmarks_snapshot()
		state.merge({"has_video": true, "duration_ms": 120000, "position_ms": video.control.observed_position_ms})
		return state
	menu.bookmark_loop_requested.connect(func(operation, data, media_scope): video.bookmark_loop.action(operation, data, media_scope))
	menu.bookmark_requested.connect(func(operation, marker_id, media_scope): video.bookmark_action(operation, marker_id, media_scope))
	root.add_child(menu); menu.toggle(); menu.set_process(false)
	var bands: Array = menu._buttons.filter(func(button): return button.node.has_meta("bookmark_loop_id"))
	check(bands.size() == 2 and bands.all(func(button): return is_equal_approx(button.node.position.y, menu.BookmarkMenu.LANE_Y)), "All ranges share original bookmark lane")
	check(not menu._buttons.any(func(button): return button.target == 2011), "No standalone loop button remains on playback bar")
	var band: Dictionary = bands.filter(func(button): return button.node.get_meta("bookmark_loop_id") == first.id)[0]
	var band_origin := origin(menu, int(band.target))
	request_count = host.requests.size()
	menu.update_pointer("left_hand", band_origin, -menu.global_basis.z, true)
	var hover_color: Color = band.node.material_override.get_shader_parameter("surface_color")
	check(menu.ray_hit(band_origin, -menu.global_basis.z).target == band.target and hover_color.r > band.base_color.r and hover_color.g > band.base_color.g, "Range body owns ray hit and brightens on hover")
	check(not video.bookmark_loop.active and host.requests.size() == request_count, "Hover alone never enables or seeks a range")
	menu.update_pointer("left_hand", band_origin, -menu.global_basis.z, false)
	check(band.node.material_override.get_shader_parameter("surface_color") == band.base_color, "Leaving range restores its idle brightness")
	video.requested_play = false
	tap(menu, int(band.target))
	check(video.bookmark_loop.active and video.requested_play and host.requests.back() == [10000, true], "Clicking range body starts playback at A even from pause")
	landed(video, 10000); video.bookmark_loop.tick(); menu.refresh()
	video.bookmark_loop.action("end", {"marker": b.id}, scope); landed(video, 30000); menu.refresh()
	# The visibly top segment also owns the overlapping hit area.
	video.bookmark_loop.action("save", {"id": first.id, "a": a.id, "b": c.id}, scope); menu.refresh()
	var overlap_origin: Vector3 = menu.to_global(Vector3(-menu.BAR_SEEK / 2 + menu.BAR_SEEK * 40000.0 / 120000, menu.BookmarkMenu.LANE_Y, 1))
	var overlap_hit: Dictionary = menu.ray_hit(overlap_origin, -menu.global_basis.z)
	check(menu.bookmarks.targets[overlap_hit.target].id == second.id, "Inactive overlap selects the more specific visible segment")
	tap(menu, menu.BookmarkMenu.GROUP)
	landed(video, 10000); video.bookmark_loop.tick(); menu.refresh()
	overlap_hit = menu.ray_hit(overlap_origin, -menu.global_basis.z)
	check(menu.bookmarks.targets[overlap_hit.target].id == first.id, "Active segment draws and receives range hits above overlaps")
	video.bookmark_loop.action("save", {"id": first.id, "a": a.id, "b": b.id}, scope); menu.refresh()

	tap(menu, menu.BookmarkMenu.LIST)
	check(menu.bookmarks.targets.has(menu.BookmarkMenu.ROW) and menu.bookmarks.targets.has(menu.BookmarkMenu.LOOP_ROW), "Points and complete segments appear together")
	tap(menu, menu.BookmarkMenu.NEW_LOOP)
	tap(menu, menu.BookmarkMenu.ROW)
	check(menu.bookmarks.editing.a.is_empty(), "Used A is disabled in new draft")
	tap(menu, menu.BookmarkMenu.SAVE)
	check(video.bookmark_loop.segments.size() == 2 and not menu.bookmarks.editing.is_empty(), "Incomplete draft cannot save")
	tap(menu, menu.BookmarkMenu.CANCEL_EDIT)
	tap(menu, menu.BookmarkMenu.LOOP_DELETE)
	check(menu.bookmarks.opened and video.bookmark_loop.segments.size() == 1, "Inline delete retains the manager")
	tap(menu, menu.BookmarkMenu.PANEL_UNDO)
	check(video.bookmark_loop.segments.size() == 2 and menu.bookmarks.opened, "Undo stays on same page")
	tap(menu, menu.BookmarkMenu.LOOP_DELETE)
	tap(menu, menu.BookmarkMenu.NEW_LOOP)
	tap(menu, menu.BookmarkMenu.ROW)
	check(menu.bookmarks.editing.a == a.id and menu.bookmarks.picker == "b", "Choose A on left then continue to B without replacing lists")
	tap(menu, menu.BookmarkMenu.ROW)
	check(menu.bookmarks.editing.b.is_empty(), "Same point cannot be both endpoints")
	tap(menu, menu.BookmarkMenu.ROW + 1)
	check(video.bookmark_loop.segments.size() == 1 and menu.bookmarks.editing.b == b.id, "Choosing endpoints only changes draft")
	request_count = host.requests.size()
	tap(menu, menu.BookmarkMenu.SAVE)
	first = video.bookmark_store.list_loops(vid)[0]
	check(not video.bookmark_loop.active and host.requests.size() == request_count and menu.bookmarks.editing.is_empty(), "Save commits pair without enabling or moving playback")
	tap(menu, menu.BookmarkMenu.LOOP_ROW)
	check(video.bookmark_loop.active and video.bookmark_loop.selected == first.id, "Explicit list A enables saved segment")
	landed(video, 10000); video.bookmark_loop.tick(); menu.refresh()
	tap(menu, menu.BookmarkMenu.CLOSE)
	request_count = host.requests.size()
	tap(menu, menu.BookmarkMenu.GROUP)
	check(video.bookmark_loop.active and host.requests.size() == request_count + 1, "Active timeline A restarts")
	landed(video, 10000); video.bookmark_loop.tick(); menu.refresh()
	request_count = host.requests.size()
	tap(menu, menu.BookmarkMenu.GROUP + 1)
	check(menu.bookmarks.opened and host.requests.size() == request_count, "Shared boundary opens same manager without action")
	check(menu.bookmarks.targets[menu.BookmarkMenu.LOOP_ROW].id == first.id and menu.bookmarks.targets[menu.BookmarkMenu.LOOP_ROW + 1].id == second.id, "Shared boundary keeps both complete pairs visible")
	tap(menu, menu.BookmarkMenu.LOOP_END)
	check(not video.bookmark_loop.active and host.requests.back() == [30000, true], "B exits loop and seeks endpoint")
	landed(video, 30000); menu.refresh()
	tap(menu, menu.BookmarkMenu.LOOP_ROW + 1)
	check(video.bookmark_loop.active and video.bookmark_loop.selected == second.id, "Adjacent pair starts explicitly")
	landed(video, 30000); video.bookmark_loop.tick(); menu.refresh()
	tap(menu, menu.BookmarkMenu.CLOSE); tap(menu, menu.BookmarkMenu.GROUP + 2)
	check(not video.bookmark_loop.active and host.requests.back()[0] == 50000, "Timeline B exits loop")
	landed(video, 50000); menu.refresh()
	tap(menu, menu.BookmarkMenu.GROUP)
	landed(video, 10000); video.bookmark_loop.tick(); menu.refresh()
	tap(menu, menu.BookmarkMenu.LIST)
	tap(menu, menu.BookmarkMenu.LOOP_EDIT)
	check(menu.bookmarks.picker == "b" and menu.bookmarks.targets.has(menu.BookmarkMenu.LOOP_ROW + 1), "Inline edit retains other saved segments")
	request_count = host.requests.size()
	tap(menu, menu.BookmarkMenu.ROW + 2)
	check(video.bookmark_loop.current().b == b.id and video.bookmark_loop.active, "Changing draft leaves playing definition intact")
	tap(menu, menu.BookmarkMenu.CANCEL_EDIT)
	check(video.bookmark_loop.current().b == b.id and host.requests.size() == request_count, "Cancel discards draft without playback side effects")
	tap(menu, menu.BookmarkMenu.LOOP_EDIT)
	tap(menu, menu.BookmarkMenu.EDIT_A); tap(menu, menu.BookmarkMenu.ROW + 1)
	check(menu.bookmarks.editing.a == a.id, "Editing cannot take another segment start")
	tap(menu, menu.BookmarkMenu.EDIT_B); tap(menu, menu.BookmarkMenu.ROW + 2)
	tap(menu, menu.BookmarkMenu.SAVE)
	check(video.bookmark_loop.current().b == c.id and video.bookmark_store.list_markers(vid).size() == 3, "Explicit save updates endpoint references only")
	check(not video.bookmark_loop.active and host.requests.size() == request_count, "Saving changed active range stops without seek")
	tap(menu, menu.BookmarkMenu.LOOP_ROW)
	landed(video, 10000); video.bookmark_loop.tick(); menu.refresh()
	var delete_target := menu.BookmarkMenu.DELETE_ROW + 2
	var start := origin(menu, delete_target)
	menu.press_pointer("left_hand", start, -menu.global_basis.z, true)
	menu.release_pointer("right_hand", start, -menu.global_basis.z, true)
	check(video.bookmark_loop.segments.size() == 2, "Other hand cannot delete endpoint")
	menu.update_pointer("left_hand", start, -menu.global_basis.z, false)
	menu.release_pointer("left_hand", start, -menu.global_basis.z, true)
	check(video.bookmark_loop.segments.size() == 2, "Lost tracking cancels deletion")
	video.media.playback.details.seekable = "no"; menu.refresh_values()
	tap(menu, menu.BookmarkMenu.LOOP_EDIT)
	check(not menu.bookmarks.editing.is_empty(), "Unseekable media retains management access")
	tap(menu, menu.BookmarkMenu.CANCEL_EDIT)
	tap(menu, menu.BookmarkMenu.LOOP_END)
	check(not video.bookmark_loop.active, "Active B can exit unseekable media")
	tap(menu, menu.BookmarkMenu.LOOP_END)
	check(not video.bookmark_loop.active, "B cannot activate unseekable media")
	video._bookmark_scope_sequence += 1; menu.refresh()
	check(not menu.bookmarks.opened and menu.bookmarks.editing.is_empty(), "Media scope change cancels manager and drafts")
	menu.free(); video._binding.ticket.clear(); video.free()
	print("Bookmark loops: %d checks, %d failures" % [checks, failures.size()])
	for failure in failures: push_error(failure)
	quit(0 if failures.is_empty() else 1)
