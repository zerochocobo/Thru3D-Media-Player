extends SceneTree
const Catalog := preload("res://scripts/background_library.gd")
const Menu := preload("res://scripts/scenery_menu.gd")
const Main := preload("res://scripts/main.gd")
const Rules := preload("res://scripts/panorama_background_rules.gd")
var checks:=0
var failures: Array=[]
func check(value: bool,message: String) -> void:
	checks+=1
	if not value: failures.append(message); printerr(message)
func _initialize() -> void: _run.call_deferred()
func _wait(library: Node) -> void:
	var deadline:=Time.get_ticks_msec()+10000
	while library.busy and Time.get_ticks_msec()<deadline: await process_frame
	check(not library.busy,"Import completes")
func _run() -> void:
	var base:=ProjectSettings.globalize_path("res://../../build/output/background-library-test-")+str(Time.get_ticks_usec())
	DirAccess.make_dir_recursive_absolute(base)
	var source:=base.path_join("original.png")
	var image:=Image.create(128,64,false,Image.FORMAT_RGB8); image.fill(Color(.2,.4,.6)); image.save_png(source)
	var duplicate:=base.path_join("renamed.png"); DirAccess.copy_absolute(source,duplicate)
	var library:=Catalog.new(); library.directory=base.path_join("library"); root.add_child(library)
	check(library.visible_modes().size()==2,"Reading mode stays hidden")
	check(library.allowed("global","cinema") and not library.allowed("image","cinema"),"Mode capabilities differ")
	library.import_source({"path":source,"geometry":3},"My panorama")
	await _wait(library)
	check(library.assets.size()==1,"Explicit panorama imports")
	if library.assets.is_empty(): quit(1); return
	var id:=str(library.assets.keys()[0])
	check(library.assets[id].sha256==FileAccess.get_sha256(source),"Identity hashes original bytes")
	check(library.assets[id].bytes==FileAccess.open(source,FileAccess.READ).get_length(),"Identity includes original size")
	library.import_source({"path":duplicate,"geometry":3},"Renamed file")
	await _wait(library)
	check(library.assets.size()==1,"Renamed identical source deduplicates")
	DirAccess.remove_absolute(library.thumbnail_path(id))
	library.import_source({"path":source,"geometry":3},"Repair preview"); await _wait(library)
	check(FileAccess.file_exists(library.thumbnail_path(id)) and library.assets.size()==1,"Reimport regenerates a missing thumbnail without duplicating the asset")
	check(library.bind("global",id) and library.bind("image",id),"One asset binds to multiple modes")
	check(library.rename_asset(id,"Renamed panorama"),"Rename saves")
	var reloaded:=Catalog.new(); reloaded.directory=library.directory; reloaded.load_catalog()
	check(reloaded.assets[id].title=="Renamed panorama","Rename persists")
	check(reloaded.bindings.image.id==id,"Mode references persist")
	reloaded.free()
	image.fill(Color(.7,.3,.2)); image.save_png(duplicate)
	library.import_source({"path":duplicate},"Unmarked image")
	await _wait(library)
	check(library.assets.size()==1 and library.reviews.size()==1,"Aspect ratio alone requires confirmation")
	var review:=str(library.reviews.keys()[0])
	check(library.approve_reviews([review]) and library.assets.size()==2,"Explicit confirmation adds candidate")
	var jpg_path:=base.path_join("tagged.jpg"); image.save_jpg(jpg_path)
	var jpg:=FileAccess.get_file_as_bytes(jpg_path)
	var xml: PackedByteArray="http://ns.adobe.com/xap/1.0/".to_utf8_buffer(); xml.append(0)
	xml.append_array('<x:xmpmeta GPano:ProjectionType="equirectangular"/>'.to_utf8_buffer())
	var length:=xml.size()+2
	var tagged:=PackedByteArray([255,216,255,225,(length>>8)&255,length&255]); tagged.append_array(xml); tagged.append_array(jpg.slice(2))
	FileAccess.open(jpg_path,FileAccess.WRITE).store_buffer(tagged)
	library.import_source({"path":jpg_path},"Tagged panorama"); await _wait(library)
	check(library.assets.size()==3 and library.reviews.is_empty(),"Reliable GPano metadata imports automatically")
	var square:=base.path_join("square.png"); var square_image:=Image.create(64,64,false,Image.FORMAT_RGB8); square_image.fill(Color(.3,.7,.1)); square_image.save_png(square)
	library.import_source({"path":square},"Possible VR180"); await _wait(library)
	check(library.reviews.size()==1 and library.reviews.values()[0].geometry==1,"Unmarked square requires explicit VR180 confirmation")
	library.skip_reviews(library.reviews.keys())
	check(library.reviews.is_empty() and FileAccess.file_exists(square),"Skipping never removes original")
	var ordinary:=base.path_join("ordinary.png"); var ordinary_image:=Image.create(100,75,false,Image.FORMAT_RGB8); ordinary_image.fill(Color.RED); ordinary_image.save_png(ordinary)
	library.import_source({"path":ordinary},"Ordinary image"); await _wait(library)
	check(library.assets.size()==3 and not library.error.is_empty(),"Ordinary aspect ratios are rejected")
	check(library.error==Rules.RATIO and library.import_progress.errors[0].title=="Ordinary image","Rejected images retain their filename and corrective ratio advice")
	var unsupported:=base.path_join("unsupported.heic")
	FileAccess.open(unsupported,FileAccess.WRITE).store_string("Not a supported background file format")
	library.import_files([{"uri":unsupported,"title":"Unsupported.heic"}]); await _wait(library)
	check(library.error==Rules.FORMAT,"Unsupported background files explain which formats to use")
	var too_large:=base.path_join("large.png")
	var large_header:=FileAccess.get_file_as_bytes(source)
	for pair in [[16,16384],[20,8192]]:
		for i in range(4): large_header[pair[0]+i]=(pair[1]>>(24-8*i))&255
	FileAccess.open(too_large,FileAccess.WRITE).store_buffer(large_header)
	library.import_files([{"uri":too_large,"title":"Large.png"}]); await _wait(library)
	check(library.error==Rules.DIMENSIONS,"Oversized images explain how to reduce resolution before pixel decoding")
	check(Rules.file_issue(Rules.MAX_BYTES+1,{})==Rules.FILE_SIZE,"Oversized files explain the file-size limit")
	check(Rules.size_issue(Vector2(8192,4096)).is_empty() and Rules.size_issue(Vector2(8192,8192))==Rules.DIMENSIONS,"An 8K panorama fits while an 8K square exceeds the total-pixel limit")
	var menu:=Menu.new(); menu.library=library; menu.state_provider=func(_mode): return {"selected":id,"choice":"custom","busy":false}
	root.add_child(menu); menu.open("image")
	var scene_height: float=menu._backdrop.mesh.size.y
	check(menu._cards.all(func(card): return card.id!="cinema"),"Image picker excludes cinema")
	check(menu.find_children("*","Label3D",true,false).any(func(label): return label.text==menu.I18n.t("Image mode")),"Scope identifies image mode")
	check(not menu.find_children("*","Label3D",true,false).any(func(label): return label.text==menu.I18n.t("Reading mode")),"No reading placeholder")
	menu.view="manage"; menu.refresh()
	check(menu._backdrop.mesh.size.y<scene_height,"Manager shrinks to its actual card rows")
	check(menu._cards.size()==3,"Manager shows multiple panoramas")
	check(menu._buttons.any(func(button): return button.target==menu.BULK),"Manager supports bulk selection")
	var anchor:=menu.device_status.position
	var scene_anchor: Vector3=menu._buttons.filter(func(item): return item.target==menu.SCENERY)[0].node.position
	menu.session_controls_provider=func(): return {"cinema_visible":true,"passthrough_visible":true}
	menu.refresh_session_controls()
	check(menu.device_status.position==anchor,"Footer status anchor stays fixed")
	check([menu.CINEMA_LIGHTS,menu.FREE_MOVEMENT].all(func(target): return menu._buttons.any(func(button): return button.target==target and button.enabled)),"Cinema restores both footer shortcuts")
	check(menu._buttons.filter(func(item): return item.target==menu.SCENERY)[0].node.position==scene_anchor,"Cinema shortcuts do not shift the scene entry")
	var footer: Array=menu._buttons.filter(func(item): return item.target in [menu.CINEMA_LIGHTS,menu.FREE_MOVEMENT,menu.FOLLOW,menu.TEMP_PASSTHROUGH,menu.SCENERY])
	footer.sort_custom(func(a,b): return a.rect.position.x<b.rect.position.x)
	check(footer.map(func(item): return item.target)==[menu.FOLLOW,menu.TEMP_PASSTHROUGH,menu.SCENERY,menu.CINEMA_LIGHTS,menu.FREE_MOVEMENT],"Cinema shortcuts sit to the right of Scene")
	var clear:=true
	for i in range(footer.size()-1): clear=clear and not footer[i].rect.intersects(footer[i+1].rect)
	check(clear,"Footer shortcut ray areas do not overlap")
	menu.session_controls_provider=func(): return {"cinema_visible":false}
	menu.refresh_session_controls()
	check(not menu._buttons.any(func(item): return item.target in [menu.CINEMA_LIGHTS,menu.FREE_MOVEMENT]),"Leaving cinema removes only cinema-specific shortcuts")
	var requests:=[]
	menu.session_control_requested.connect(func(operation): requests.append(operation))
	menu.session_controls_provider=func(): return {"passthrough_visible":true,"passthrough_supported":false,"passthrough":true}
	menu.refresh_session_controls()
	var unsupported_pass: Array=menu._buttons.filter(func(item): return item.target==menu.TEMP_PASSTHROUGH)
	check(unsupported_pass.size()==1 and not unsupported_pass[0].enabled,"Unsupported passthrough stays visible but disabled")
	check(menu._tips.get(menu.TEMP_PASSTHROUGH,"")==menu.I18n.t("Passthrough unavailable on this headset right now"),"Unsupported passthrough explains itself")
	check(menu._activate_footer(menu.TEMP_PASSTHROUGH) and requests.is_empty(),"Unsupported passthrough ignores activation")
	check(library.remove_assets([id]),"Remove selected background")
	check(library.bindings.global.id=="cinema" and library.bindings.image.id=="belfast","All mode references fall back")
	check(FileAccess.file_exists(source) and FileAccess.file_exists(duplicate),"Original files remain")
	check(not FileAccess.file_exists(library.image_path(id)),"Only private asset is removed")
	check(not library.valid_id("../../source"),"Asset IDs cannot escape library")
	var catalog:=library.directory.path_join("catalog.json")
	FileAccess.open(catalog,FileAccess.WRITE).store_string("broken")
	var recovery:=Catalog.new(); recovery.directory=library.directory; recovery.load_catalog()
	check(not recovery.assets.is_empty(),"Corrupt index recovers from portable backup")
	check(recovery.save_catalog(),"Recovered index saves without discarding its good backup")
	recovery.free()
	menu.free(); library.free()
	print("Background library: %d checks, %d failures"%[checks,failures.size()]); quit(0 if failures.is_empty() else 1)
