extends RefCounted
## Cloud-only angular advection. Artistic distant layer, not volumetric weather.
const TimeOfDay = preload("res://scripts/environments/private_beach_time.gd")
const IDLE_RADIANS_PER_SECOND := .00018
const SCRUB_RADIANS_PER_HOUR := .32
var drift := 0.0
var deformation := 0.0
var update_accumulator := 0.0
var weather_hours := 9.0
var weather_seed := 20261107
# Desktop diagnostics may pin coverage; the interactive scene leaves this -1.
var density_override := -1.0

func day_density(day: int) -> float:
	var value := fposmod(sin(float(day)*12.9898+float(weather_seed%10000)*.017)*43758.5453,1.0)
	if value<.25: return 0.0
	if value<.50: return .45
	if value<.85: return .75
	return 1.0

func density() -> float:
	if density_override>=0: return clampf(density_override,0,1)
	# A seeded weather day, blended during four hours around dawn. No reroll
	# during scrubbing; clear days genuinely reach zero coverage.
	var day := int(floor((weather_hours-6.0)/24.0))
	var transition := smoothstep(0.0,4.0,fposmod(weather_hours-6.0,24.0))
	return lerpf(day_density(day-1),day_density(day),transition)

func shift(radians: float) -> void:
	drift=fposmod(drift+radians,TAU)
	deformation=fposmod(deformation+radians*.37,TAU)

func scrub(previous: float,current: float) -> void:
	# Incremental signed deltas preserve continuity over midnight and reversals.
	var hours := TimeOfDay.hour_delta(current,previous)
	weather_hours+=hours
	shift(hours*SCRUB_RADIANS_PER_HOUR)

func advance(seconds: float) -> bool:
	shift(maxf(seconds,0.0)*IDLE_RADIANS_PER_SECOND)
	weather_hours+=maxf(seconds,0.0)/3600.0
	update_accumulator+=maxf(seconds,0.0)
	if update_accumulator<.05: return false
	update_accumulator=fposmod(update_accumulator,.05)
	return true

func state() -> Vector4:
	return Vector4(cos(drift),sin(drift),cos(deformation),sin(deformation))

func apply(materials: Array) -> void:
	for material: ShaderMaterial in materials:
		material.set_shader_parameter("cloud_motion",state())
		material.set_shader_parameter("cloud_density",density())

func coverage(direction: Vector3,texture: Image) -> float:
	var c := state()
	var ray := Vector3(c.x*direction.x-c.y*direction.z,direction.y,c.y*direction.x+c.x*direction.z)
	var weight := smoothstep(.04,.35,direction.y)*(1.0-.3*maxf(direction.y,0.0))
	ray=(ray+Vector3(c.z-1.0,0,c.w)*(.035*weight)).normalized()
	var width := texture.get_width(); var height := texture.get_height()
	var u := atan2(ray.x,ray.z)/TAU+.5
	var v := clampf(acos(clampf(ray.y,-1,1))/PI,.5/height,1.0-.5/height)
	var point := Vector2(u*width-.5,v*height-.5)
	var x := int(floor(point.x)); var y := int(floor(point.y))
	var a := texture.get_pixel(posmod(x,width),clampi(y,0,height-1)).r
	var b := texture.get_pixel(posmod(x+1,width),clampi(y,0,height-1)).r
	var e := texture.get_pixel(posmod(x,width),clampi(y+1,0,height-1)).r
	var f := texture.get_pixel(posmod(x+1,width),clampi(y+1,0,height-1)).r
	var raw := lerpf(lerpf(a,b,point.x-floor(point.x)),lerpf(e,f,point.x-floor(point.x)),point.y-floor(point.y))
	var amount := density()
	return clampf((raw-(1.0-amount))/maxf(amount,.0001),0,1)*smoothstep(0.0,.2,amount)

func transmission(direction: Vector3,texture: Image) -> float:
	# Average the celestial disc so partial cover dims the light continuously.
	var right := direction.cross(Vector3.UP).normalized()
	if right.length_squared()<.5: right=Vector3.RIGHT
	var up := right.cross(direction).normalized()
	var cover := coverage(direction,texture)
	for index in 8:
		var angle := float(index)*TAU/8.0
		cover+=coverage((direction+(right*cos(angle)+up*sin(angle))*.00465).normalized(),texture)
	return 1.0-.85*cover/9.0
