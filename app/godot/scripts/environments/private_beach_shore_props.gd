		var bank: float=-.35*signf(bird.speed)
		node.transform=Transform3D(Basis.looking_at(heading,Vector3.UP).rotated(heading,bank).scaled(Vector3.ONE*float(bird.scale)),position)
		# Glide most of the time; a burst of beats every few seconds.
		var cycle: float=fmod(time+float(bird.flap),9.0)
		var beat: float=sin(time*9.0)*.55 if cycle<1.6 else .08*sin(time*.9)
