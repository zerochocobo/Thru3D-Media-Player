static func arc_normal(x: float,radius: float) -> Vector3:
	return Vector3(0,0,1) if radius<=0 else Vector3(-sin(x/radius),0,cos(x/radius))

static func arc_tangent(x: float,radius: float) -> Vector3:
	return Vector3(1,0,0) if radius<=0 else Vector3(cos(x/radius),0,sin(x/radius))

