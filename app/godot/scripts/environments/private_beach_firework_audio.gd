# Generated by tools/beach/stage_runtime.py; edit the source in tools/beach.
extends Node3D
## Reuses puzzle_audio.gd's bounded AudioStreamPlayer3D pool pattern.
const VOLUMES := {"launch":-14.0,"launch2":-14.0,"burst":-4.0,"burst2":-4.0}
var listener: Camera3D
var bank: Array[AudioStreamWAV]=[]
var voices: Array[Dictionary]=[]
var arrivals: Array[Dictionary]=[]
var events: Array[Dictionary]=[]
var clock := 0.0
var evidence_record: Dictionary={}
var fade_remaining := -1.0

func configure(camera: Camera3D,folder: String,count: int) -> void:
	listener=camera
	evidence_record=JSON.parse_string(FileAccess.get_file_as_string(folder.path_join("audio-build.json")))
	var streams: Array=[]
	for record in evidence_record.streams:
		var path := folder.path_join(record.file)
		assert(FileAccess.get_sha256(path)==record.sha256)
		var stream := AudioStreamWAV.load_from_file(path)
		assert(stream!=null); streams.append(stream)
	configure_streams(camera,streams,count)

func configure_streams(camera: Camera3D,streams: Array,count: int) -> void:
	listener=camera
	bank.assign(streams)
	for index in count:
		var pair := {}
		for kind in VOLUMES:
			var player := AudioStreamPlayer3D.new(); add_child(player)
			# A festival burst is now ~180-210m away. A 220m cutoff adds a
			# second steep fade on top of distance attenuation as the viewer walks.
			# The fixed four-voice pool needs no distance-based voice culling.
			player.attenuation_model=AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
			player.unit_size=60.0; player.max_distance=0.0; player.panning_strength=.9
			player.volume_db=VOLUMES[kind]
			player.attenuation_filter_cutoff_hz=6000; player.attenuation_filter_db=-12
			pair[kind]=player
		voices.append(pair)

## A salvo's second break gets its own bang, from its own point and time.
func schedule_launch_second(slot: int,launch: Vector3) -> void:
	var distance := listener.global_position.distance_to(launch)
	arrivals.append({"slot":slot,"kind":"launch2","point":launch,"due":clock+distance/343.0,
		"emission":clock,"distance":distance,"stream":0,"pitch":1.0})

func schedule_second(slot: int,burst: Vector3,style: int,pitch: float,delay: float) -> void:
	var distance := listener.global_position.distance_to(burst)
	arrivals.append({"slot":slot,"kind":"burst2","point":burst,"due":clock+delay+distance/343.0,
		"emission":clock+delay,"distance":distance,"stream":1+style,"pitch":pitch})

func schedule(slot: int,launch: Vector3,burst: Vector3,style: int,pitch: float,flight_time: float) -> void:
	for kind in ["launch","burst"]:
		var position := launch if kind=="launch" else burst
		var emission := clock+(0.0 if kind=="launch" else flight_time)
		var distance := listener.global_position.distance_to(position)
		arrivals.append({"slot":slot,"kind":kind,"point":position,"due":emission+distance/343.0,
			"emission":emission,"distance":distance,"stream":0 if kind=="launch" else 1+style,"pitch":pitch})

func advance(delta: float) -> void:
	clock+=maxf(0.0,delta)
	if fade_remaining>=0.0:
		fade_remaining=maxf(0.0,fade_remaining-delta)
		for pair in voices:
			for kind in pair:
				pair[kind].volume_db=VOLUMES[kind]+linear_to_db(maxf(.0001,fade_remaining/.25))
		if fade_remaining==0.0: stop_all(); fade_remaining=-1.0
	for index in range(arrivals.size()-1,-1,-1):
		var event: Dictionary=arrivals[index]
		if event.due>clock: continue
		var player: AudioStreamPlayer3D=voices[event.slot][event.kind]
		player.global_position=event.point; player.stream=bank[event.stream]; player.pitch_scale=event.pitch; player.play()
		events.append({"kind":event.kind,"emission":event.emission,"due":event.due,"started":clock,"distance":event.distance})
		if events.size()>64: events.pop_front()
		arrivals.remove_at(index)

func stop_all() -> void:
	arrivals.clear()
	for pair in voices:
		for player in pair.values(): player.stop()

func fade_out() -> void:
	arrivals.clear(); fade_remaining=.25

func resume() -> void:
	fade_remaining=-1.0
	for pair in voices:
		for kind in pair: pair[kind].volume_db=VOLUMES[kind]

func _exit_tree() -> void:
	stop_all()
