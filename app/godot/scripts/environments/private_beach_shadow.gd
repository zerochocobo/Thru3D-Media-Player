extends RefCounted
## Desktop candidate: shared geometry, two depth views, redraw only on time/pose change.
const DepthShader = preload("res://shaders/private_beach/moving_shadow_depth.gdshader")
var views: Array[SubViewport]=[]
var cameras: Array[Camera3D]=[]
var casters: Array[Dictionary]=[]
var materials: Array[ShaderMaterial]=[]
var extent := Vector2(12,520)
var focus := Vector3(0,.5,6)
var direction := Vector3.UP
var initialized := false
var near_updates := 0
var draw_updates := 0
var caster_surfaces := 0
var opaque: ShaderMaterial
## Optional top-down bake of ground visibility around the focus (see sand_visibility.gdshader).
const RECEIVER_SIZE := 1024
var receiver_extent := 32.0
var receiver: SubViewport
var receiver_camera: Camera3D
var receiver_materials: Array[ShaderMaterial]=[]
var receiver_updates := 0

func create(parent: Node,meshes: Array) -> void:
	for index in range(2):
		var view := SubViewport.new(); view.name="SolarDepth"+str(index)
		view.size=Vector2i(1024,1024)
		# Establish a full-geometry shadow reference before selecting shadow LODs.
		# The low-sun triangle patches were receiver-plane errors, not fixed by this.
		view.mesh_lod_threshold=0.0
		view.own_world_3d=index==0
		view.render_target_update_mode=SubViewport.UPDATE_DISABLED
		parent.add_child(view)
		# world_3d stays null under own_world_3d and would inherit the main scene.
		if index==1: view.world_3d=views[0].find_world_3d()
		var camera := Camera3D.new(); view.add_child(camera); camera.current=true
		camera.projection=Camera3D.PROJECTION_ORTHOGONAL; camera.size=extent[index]
		camera.near=.1; camera.far=1000.0
		var environment := Environment.new(); environment.background_mode=Environment.BG_COLOR
		environment.background_color=Color.WHITE
		camera.environment=environment
		views.append(view); cameras.append(camera)
	opaque=ShaderMaterial.new(); opaque.shader=DepthShader
	for source: MeshInstance3D in meshes: add_caster(source)

func add_caster(source: MeshInstance3D) -> Dictionary:
	var proxy := MeshInstance3D.new(); proxy.name="Depth_"+str(source.name)
	proxy.mesh=source.mesh; views[0].add_child(proxy); proxy.global_transform=source.global_transform
	for surface in source.mesh.get_surface_count():
		var original := source.get_active_material(surface)
		var material := opaque
		if original is ShaderMaterial and original.shader.code.contains("uniform sampler2D leaf_alpha"):
			material=opaque.duplicate() as ShaderMaterial
			material.set_shader_parameter("cutout",true)
			material.set_shader_parameter("leaf_alpha",original.get_shader_parameter("leaf_alpha"))
		proxy.set_surface_override_material(surface,material)
		caster_surfaces+=1
	var item := {"source":source,"proxy":proxy}
	casters.append(item)
	return item

func replace_casters(previous: Array,meshes: Array) -> Array:
	# Screen edits swap their supports; the static scene keeps its proxies.
	for item: Dictionary in previous:
		casters.erase(item); (item.proxy as Node).free()
	var added: Array=[]
	for source: MeshInstance3D in meshes: added.append(add_caster(source))
	return added

## The terrain drawn from above with a visibility material; the near cascade's
## focus centres it. Receivers then read one texel instead of filtering the maps.
func create_receiver(parent: Node,terrain: MeshInstance3D,material: ShaderMaterial) -> void:
	receiver=SubViewport.new(); receiver.name="GroundVisibility"
	receiver.size=Vector2i(RECEIVER_SIZE,RECEIVER_SIZE); receiver.mesh_lod_threshold=0.0
	receiver.own_world_3d=true; receiver.render_target_update_mode=SubViewport.UPDATE_DISABLED
	parent.add_child(receiver)
	receiver_camera=Camera3D.new(); receiver.add_child(receiver_camera); receiver_camera.current=true
	receiver_camera.projection=Camera3D.PROJECTION_ORTHOGONAL; receiver_camera.size=receiver_extent
	receiver_camera.near=.1; receiver_camera.far=1000.0
	var environment := Environment.new(); environment.background_mode=Environment.BG_COLOR
	environment.background_color=Color.WHITE; receiver_camera.environment=environment
	var proxy := MeshInstance3D.new(); proxy.name="Ground"; proxy.mesh=terrain.mesh
	proxy.material_override=material; receiver.add_child(proxy); proxy.global_transform=terrain.global_transform

func bind_receiver(material: ShaderMaterial) -> void:
	receiver_materials.append(material)
	material.set_shader_parameter("ground_visibility",receiver.get_texture())
	_place_receiver()

func _place_receiver() -> void:
	if receiver==null: return
	var texel := receiver_extent/RECEIVER_SIZE
	var center := Vector3(snappedf(focus.x,texel),0,snappedf(focus.z,texel))
	# Looking straight down with -Z up: image X follows world X, image rows follow world Z.
	receiver_camera.global_transform=Transform3D(Basis(Vector3.RIGHT,Vector3.FORWARD,Vector3.UP),center+Vector3.UP*500.0)
	var rect := Vector4(center.x-receiver_extent*.5,center.z-receiver_extent*.5,receiver_extent,receiver_extent)
	for material in receiver_materials: material.set_shader_parameter("ground_visibility_rect",rect)
	receiver.render_target_update_mode=SubViewport.UPDATE_ONCE
	receiver_updates+=1

func bind(material: ShaderMaterial) -> void:
	materials.append(material)
	material.set_shader_parameter("moving_shadow_near",views[0].get_texture())
	material.set_shader_parameter("moving_shadow_far",views[1].get_texture())
	material.set_shader_parameter("moving_shadow_extent",extent)

func refresh_view(index: int,target: Vector3) -> void:
	cameras[index].position=target+direction*500.0
	cameras[index].look_at(target,Vector3.FORWARD if absf(direction.y)>.98 else Vector3.UP)
	if index==0:
		var right := cameras[index].global_basis.x
		var up := cameras[index].global_basis.y
		var texel := extent.x/float(views[0].size.x)
		var x := target.dot(right); var y := target.dot(up)
		cameras[index].position+=right*(snappedf(x,texel)-x)+up*(snappedf(y,texel)-y)
	for material in materials:
		material.set_shader_parameter("moving_shadow_near_view" if index==0 else "moving_shadow_far_view",cameras[index].global_transform.affine_inverse())
	views[index].render_target_update_mode=SubViewport.UPDATE_ONCE
	if index==0: near_updates+=1
	_place_receiver()

func set_focus(position: Vector3) -> void:
	# World-metre tiles keep small head movements from redrawing the map. The
	# one-metre blend border covers recentering; rotate-only views do not redraw.
	var next := Vector3(roundf(position.x),position.y,roundf(position.z))
	if next.distance_squared_to(focus)<.0001: return
	focus=next
	if initialized: refresh_view(0,focus)

func update(solar_direction: Vector3) -> void:
	direction=solar_direction; initialized=true
	refresh_view(0,focus)
	refresh_view(1,Vector3(0,2,4))
	for item in casters:
		if not is_instance_valid(item.source): continue
		item.proxy.global_transform=item.source.global_transform
		item.proxy.visible=item.source.is_visible_in_tree()
	draw_updates+=1

func evidence() -> Dictionary:
	return {"cascades":[[views[0].size.x,extent.x],[views[1].size.x,extent.y]],"casters":casters.size(),"caster_surfaces":caster_surfaces,
		"updates":draw_updates,"near_updates":near_updates,"rgba8_image_payload_bytes":(views[0].size.x*views[0].size.y+views[1].size.x*views[1].size.y)*4,
		"scope":"RGBA8 image payload is not a measurement of color/depth attachment allocation. Shares original mesh buffers; full shadow geometry reference. No mobile GPU benchmark."}
