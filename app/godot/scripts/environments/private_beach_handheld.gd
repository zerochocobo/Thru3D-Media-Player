static func _spray(held: Dictionary,tip: Vector3,delta: float,burning: bool) -> void:
	var sparks: Array=held.sparks
	if burning:
		held.spawn=float(held.spawn)+delta*SPARKS_PER_SECOND
		while held.spawn>=1.0:
			held.spawn=float(held.spawn)-1.0
			var direction := Vector3(randf_range(-1,1),randf_range(-1,1),randf_range(-1,1))
			if direction.length_squared()<.01: direction=Vector3.UP
			sparks.append({"position":tip,"velocity":direction.normalized()*randf_range(SPARK_SPEED.x,SPARK_SPEED.y),
				"age":0.0,"life":randf_range(SPARK_LIFE.x,SPARK_LIFE.y),"branch":randf()<SPARK_BRANCH,"width":.0011})
	for spark in sparks.duplicate():
		spark.age=float(spark.age)+delta
		spark.velocity=(spark.velocity as Vector3)*maxf(0.0,1.0-SPARK_DRAG*delta)+Vector3.DOWN*1.5*delta
		spark.position=(spark.position as Vector3)+(spark.velocity as Vector3)*delta
		if float(spark.age)<float(spark.life): continue
		sparks.erase(spark)
		# The end of a spark bursts into a small star of fine rays.
		if spark.branch:
			for ray in STAR_RAYS:
				var direction := Vector3(randf_range(-1,1),randf_range(-1,1),randf_range(-1,1))
				if direction.length_squared()<.01: continue
				sparks.append({"position":spark.position,"velocity":direction.normalized()*randf_range(.5,1.1),
					"age":0.0,"life":randf_range(.05,.1),"branch":false,"width":.0007})

## Each spark is drawn as a thin streak along its motion, facing the viewer:
## white-hot when young, cooling to gold as it fades.
static func _draw_streaks(node: MeshInstance3D,sparks: Array,eye: Vector3) -> void:
	var mesh: ImmediateMesh=node.mesh
	mesh.clear_surfaces()
	if sparks.is_empty(): return
	mesh.surface_begin(Mesh.PRIMITIVE_TRIANGLES)
	for spark in sparks:
		var head: Vector3=spark.position
		var tail: Vector3=head-(spark.velocity as Vector3)*STREAK_SECONDS
		var along: Vector3=head-tail
		if along.length_squared()<1e-8: along=Vector3.UP*.002
		var side: Vector3=along.cross(eye-head).normalized()*float(spark.width)
		var fade: float=1.0-float(spark.age)/float(spark.life)
		var hot := Color(1,.97,.9,fade).lerp(Color(1,.72,.35,fade*.8),1.0-fade)
		var cool := Color(hot.r,hot.g*.85,hot.b*.6,0.0)
		for vertex in [[head+side,hot],[head-side,hot],[tail-side,cool],[head+side,hot],[tail-side,cool],[tail+side,cool]]:
			mesh.surface_set_color(vertex[1]); mesh.surface_add_vertex(vertex[0])
	mesh.surface_end()

static func _streak_mesh(parent: Node3D) -> MeshInstance3D:
	var streaks := MeshInstance3D.new(); streaks.name="Glow_Streaks"; streaks.mesh=ImmediateMesh.new()
	var material := StandardMaterial3D.new(); material.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED
	material.transparency=BaseMaterial3D.TRANSPARENCY_ALPHA; material.blend_mode=BaseMaterial3D.BLEND_MODE_ADD
	material.cull_mode=BaseMaterial3D.CULL_DISABLED; material.vertex_color_use_as_albedo=true
	streaks.material_override=material; streaks.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	parent.add_child(streaks); streaks.top_level=true; streaks.global_transform=Transform3D.IDENTITY
	return streaks

static func _draw_ribbon(ribbon: MeshInstance3D,trail: Array,eye: Vector3,delta: float) -> void:
	var mesh: ImmediateMesh=ribbon.mesh
	mesh.clear_surfaces()
	if trail.size()<3: return
	# Brightness follows the tip's speed over the last few frames, steady against tracking jitter.
	var back := 1
	while back<trail.size()-1 and float(trail[back].age)<.05: back+=1
	var speed: float=(trail[0].point as Vector3).distance_to(trail[back].point)/maxf(float(trail[back].age),delta)
	var strength := clampf((speed-TRAIL_START)/(TRAIL_FULL-TRAIL_START),0.0,1.0)
	if strength<=.01: return
	mesh.surface_begin(Mesh.PRIMITIVE_TRIANGLE_STRIP)
	for index in trail.size():
		var point: Vector3=trail[index].point
		var next: Vector3=trail[mini(index+1,trail.size()-1)].point
		var previous: Vector3=trail[maxi(index-1,0)].point
		var along: Vector3=(previous-next)
		if along.length_squared()<1e-8: along=Vector3.UP
		var side: Vector3=along.cross(eye-point).normalized()
		var fade: float=1.0-float(index)/(trail.size()-1)
		var width: float=.006+.01*fade
		var color := Color(1,.78,.42,fade*fade*strength)
		mesh.surface_set_color(color); mesh.surface_add_vertex(point+side*width)
		mesh.surface_set_color(color); mesh.surface_add_vertex(point-side*width)
	mesh.surface_end()

static func _fire_candle(state: Dictionary,held: Dictionary,hand: String,delta: float,events: Array) -> bool:
	held.next_shot=float(held.next_shot)-delta
	if int(held.shots)<CANDLE_SHOTS and float(held.next_shot)<=0.0:
		held.next_shot=CANDLE_INTERVAL; held.shots=int(held.shots)+1
		var node: Node3D=held.node
		var muzzle: Vector3=node.global_transform*(Vector3.UP*CANDLE_LENGTH)
		var axis: Vector3=node.global_basis.y.normalized()
		var color: Color=BALL_COLORS[(int(held.shots)+hand.length())%BALL_COLORS.size()]
		var ball := MeshInstance3D.new(); ball.name="Glow_Ball"; ball.mesh=state.ball_mesh
		var material := StandardMaterial3D.new(); material.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED
		material.transparency=BaseMaterial3D.TRANSPARENCY_ALPHA; material.blend_mode=BaseMaterial3D.BLEND_MODE_ADD
		material.billboard_mode=BaseMaterial3D.BILLBOARD_ENABLED; material.albedo_texture=_ball_texture(); material.albedo_color=color
		ball.material_override=material; (state.root as Node3D).add_child(ball); ball.global_position=muzzle
		state.balls.append({"node":ball,"velocity":axis*CANDLE_SPEED,"age":0.0,"color":color})
		events.append({"hand":hand,"strength":.55,"sound":"pop"})
	# Spent once the last ball has left and the tube has cooled for a moment.
	return int(held.shots)>=CANDLE_SHOTS and float(held.next_shot)<CANDLE_INTERVAL-.8

static func _fly_balls(state: Dictionary,delta: float) -> void:
	for ball in state.balls.duplicate():
		ball.age=float(ball.age)+delta
		var node: MeshInstance3D=ball.node
		ball.velocity=(ball.velocity as Vector3)+Vector3.DOWN*GRAVITY*delta
		node.global_position+=(ball.velocity as Vector3)*delta
		var life: float=1.0-float(ball.age)/BALL_SECONDS
		(node.material_override as StandardMaterial3D).albedo_color=Color(ball.color,clampf(life*1.4,0,1))
		if life<=0.0:
			node.queue_free(); state.balls.erase(ball)

static func clear(state: Dictionary) -> void:
	for held in state.held.values():
		for key in ["ribbon","streaks"]:
			if held.has(key): (held[key] as Node).queue_free()
		(held.node as Node).queue_free()
	state.held.clear()
	for ball in state.balls: (ball.node as Node).queue_free()
	state.balls.clear()

static func _glow(node: Node3D) -> MeshInstance3D:
	var glow := MeshInstance3D.new(); glow.name="Glow_Tip"
	var quad := QuadMesh.new(); quad.size=Vector2.ONE*.09; glow.mesh=quad
	var material := StandardMaterial3D.new(); material.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED
	material.transparency=BaseMaterial3D.TRANSPARENCY_ALPHA; material.blend_mode=BaseMaterial3D.BLEND_MODE_ADD
	material.billboard_mode=BaseMaterial3D.BILLBOARD_ENABLED; material.albedo_texture=_ball_texture(); material.albedo_color=Color(1,.98,.92,1)
	glow.material_override=material; node.add_child(glow)
	var halo := MeshInstance3D.new(); halo.name="Glow_Halo"
	var wide := QuadMesh.new(); wide.size=Vector2.ONE*.32; halo.mesh=wide
	var soft: StandardMaterial3D=material.duplicate(); soft.albedo_color=Color(1,.78,.62,.38)
	halo.material_override=soft; glow.add_child(halo)
	return glow

static func _ribbon(parent: Node3D) -> MeshInstance3D:
	var ribbon := MeshInstance3D.new(); ribbon.name="Glow_Trail"; ribbon.mesh=ImmediateMesh.new()
	var material := StandardMaterial3D.new(); material.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED
	material.transparency=BaseMaterial3D.TRANSPARENCY_ALPHA; material.blend_mode=BaseMaterial3D.BLEND_MODE_ADD
	material.cull_mode=BaseMaterial3D.CULL_DISABLED; material.vertex_color_use_as_albedo=true
	ribbon.material_override=material; ribbon.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	parent.add_child(ribbon); ribbon.top_level=true
	return ribbon

static func _ball_mesh() -> QuadMesh:
	var quad := QuadMesh.new(); quad.size=Vector2.ONE*.22
	return quad

static func _ball_texture() -> GradientTexture2D:
	var gradient := Gradient.new(); gradient.set_color(0,Color(1,1,1,1)); gradient.set_color(1,Color(1,1,1,0))
	gradient.add_point(.22,Color(1,1,1,.8))
	var texture := GradientTexture2D.new(); texture.gradient=gradient; texture.width=32; texture.height=32
	texture.fill=GradientTexture2D.FILL_RADIAL; texture.fill_from=Vector2(.5,.5); texture.fill_to=Vector2(1,.5)
	return texture
