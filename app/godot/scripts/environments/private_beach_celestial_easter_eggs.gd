static func _profile(st: SurfaceTool,outline: Array,width: float) -> void:
	var polygon := PackedVector2Array(outline)
	var triangles := Geometry2D.triangulate_polygon(polygon)
	for side in [-1.0,1.0]:
		var vertices := PackedVector3Array()
		for p in outline:
			var half_width: float=width*lerpf(.65,1.0,clampf((p.x+11.0)/7.0,0,1))
			vertices.append(Vector3(side*half_width,p.y,p.x))
		for index in range(0,triangles.size(),3):
			_tri(st,vertices[triangles[index]],vertices[triangles[index+1]],vertices[triangles[index+2]])
	for index in outline.size():
		var next := (index+1)%outline.size()
		var p: Vector2=outline[index]; var q: Vector2=outline[next]
		var wp: float=width*lerpf(.65,1.0,clampf((p.x+11)/7,0,1))
		var wq: float=width*lerpf(.65,1.0,clampf((q.x+11)/7,0,1))
		_tri(st,Vector3(-wp,p.y,p.x),Vector3(wp,p.y,p.x),Vector3(-wq,q.y,q.x))
		_tri(st,Vector3(-wq,q.y,q.x),Vector3(wp,p.y,p.x),Vector3(wq,q.y,q.x))

static func _body_row(y: float) -> Vector4:
	for index in BODY.size()-1:
		if y <= BODY[index+1].x:
			return BODY[index].lerp(BODY[index+1],clampf((y-BODY[index].x)/(BODY[index+1].x-BODY[index].x),0,1))
	return BODY[-1]

static func _back_at(y: float, x: float) -> float:
	var row := _body_row(y)
	return (row.z+row.w)*.5+(row.w-row.z)*.5*sqrt(maxf(0.0,1.0-pow(x/row.y,2)))

static func _loft(st: SurfaceTool, rows: Array) -> void:
	const SIDES := 20
	var rings: Array[PackedVector3Array]=[]
	for row: Vector4 in rows:
		var ring := PackedVector3Array()
		for index in SIDES:
			var angle := TAU*index/SIDES
			ring.append(Vector3(sin(angle)*row.y,row.x,(row.z+row.w)*.5+cos(angle)*(row.w-row.z)*.5))
		rings.append(ring)
	for row in rings.size()-1:
		for index in SIDES:
			var next := (index+1)%SIDES
			_tri(st,rings[row][index],rings[row+1][index],rings[row][next])
			_tri(st,rings[row][next],rings[row+1][index],rings[row+1][next])
	for end in [0,rings.size()-1]:
		var centre := Vector3(0,rows[end].x,(rows[end].z+rows[end].w)*.5)
		for index in SIDES: _tri(st,centre,rings[end][index],rings[end][(index+1)%SIDES])

static func _tri(st: SurfaceTool, a: Vector3,b: Vector3,c: Vector3) -> void:
	var normal := (b-a).cross(c-a).normalized()
	for point in [a,b,c]: st.set_normal(normal); st.add_vertex(point)

static func _rod(st: SurfaceTool,a: Vector3,b: Vector3,ra: float,rb: float) -> void:
	var cylinder := CylinderMesh.new(); cylinder.bottom_radius=ra; cylinder.top_radius=rb
	cylinder.height=a.distance_to(b); cylinder.radial_segments=12; cylinder.rings=1
	var part := SurfaceTool.new(); part.create_from(cylinder,0); part.deindex()
	st.append_from(part.commit(),0,Transform3D(Basis(Quaternion(Vector3.UP,(b-a).normalized())),(a+b)*.5))

static func _dorsal(st: SurfaceTool,y: float,size: float,x: float) -> void:
	# Wide rock-like plates, with the entire root following (and penetrating)
	# the back. Three interleaved rows create an irregular crown, not a saw blade.
	var outline := [Vector2(-1,0),Vector2(-.85,.55),Vector2(-.5,.42),Vector2(-.65,1.3),
		Vector2(-.15,1.05),Vector2(.2,2.0),Vector2(.4,1.15),Vector2(.8,1.35),Vector2(.65,.5),Vector2(1,0)]
	var edges: Array[PackedVector3Array]=[]
	for side in [-1.0,1.0]:
		var edge := PackedVector3Array()
		for p in outline:
			var height: float=y+p.x*size
			var lateral: float=x+side*.38
			edge.append(Vector3(lateral,height+p.y*size*.9,_back_at(height,lateral)-.85+p.y*size))
		edges.append(edge)
		# Fan centre sits in the embedded root band, keeping the base continuous.
		var centre := Vector3(x+side*.38,y,_back_at(y,x+side*.38)-.45)
		for index in edge.size(): _tri(st,centre,edge[index],edge[(index+1)%edge.size()])
	for index in outline.size():
		var next := (index+1)%outline.size()
		_tri(st,edges[0][index],edges[1][index],edges[0][next])
		_tri(st,edges[0][next],edges[1][index],edges[1][next])
