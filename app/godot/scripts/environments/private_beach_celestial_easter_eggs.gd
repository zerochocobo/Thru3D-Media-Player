## Select the widest open-water window beside the actual movie screen. The
## horizon, movie and coastline keep their real depth; no overlay or screen move.
func _plan_route(eye: Vector3) -> Dictionary:
	var left := deg_to_rad(-26.0); var right := deg_to_rad(26.0)
	for point in _coast:
		if float(point[1]) > -50.0: continue
		var angle := atan2(float(point[0])-eye.x,eye.z-float(point[1]))
		if float(point[0]) < 0: left = maxf(left,angle)
		else: right = minf(right,angle)
	var screen_left := 0.0; var screen_right := 0.0
	if not _view_screen.is_empty():
		screen_left = PI; screen_right = -PI
		for corner: Vector3 in _view_screen.corners:
			var angle := atan2(corner.x-eye.x,eye.z-corner.z)
			screen_left = minf(screen_left,angle); screen_right = maxf(screen_right,angle)
	# Leave more room against the cape than against the nearby screen edge.
	var intervals := [Vector2(left+deg_to_rad(2.0),minf(right,screen_left)-deg_to_rad(.55)),
		Vector2(maxf(left,screen_right)+deg_to_rad(.55),right-deg_to_rad(2.0))]
	var slot: Vector2 = intervals[0] if intervals[0].y-intervals[0].x > intervals[1].y-intervals[1].x else intervals[1]
	var side := -1.0 if slot.x+slot.y<0 else 1.0
	var distance := 2300.0
	# Above-water geometry spans about 132 m in side profile. It travels toward
	# the screen side of the opening, then submerges before reaching that edge.
	var front := atan2(56.0,distance); var back := atan2(81.0,distance)
	var low := slot.x+(front if side>0 else back)
	var high := slot.y-(back if side>0 else front)
	if high < low: return {}
	var travel_angle := minf(deg_to_rad(3.0),high-low)
	var first := (low+high)*.5+side*travel_angle*.5
	# A broad opening gets a longer swim. The centre chair uses the shorter
	# available arc; the creature moves forwards along its side-on heading.
	var final_angle := first-side*travel_angle
	var start := eye+Vector3(sin(first),0,-cos(first))*distance
	var finish := eye+Vector3(sin(final_angle),0,-cos(final_angle))*distance
	start.y=sea_level; finish.y=sea_level
	return {"start":start,"end":finish,"side":side,"window":slot,"travel_angle":travel_angle}

func configure(level: float, sound: AudioStream, seed_value: int = -1) -> void:
	sea_level = level
	if seed_value < 0: random.randomize()
	else: random.seed = seed_value
	monster = MeshInstance3D.new(); monster.name = "SeaMonster"
	monster.mesh = _monster_mesh()
	# A distant, hazy silhouette hides primitive joins; never light it like a
	# close-up character. The low contrast is deliberate, not a black foreground prop.
	var skin := StandardMaterial3D.new(); skin.albedo_color = Color(.36,.46,.53); skin.roughness = .92
	skin.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	skin.cull_mode = BaseMaterial3D.CULL_DISABLED
	monster.material_override = skin; monster.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(monster)
	roar = AudioStreamPlayer3D.new(); roar.name = "DistantRoar"; roar.stream = sound
	roar.unit_size = 850.0; roar.volume_db = -13.0; roar.max_polyphony = 1
	roar.attenuation_filter_cutoff_hz = 3000; roar.attenuation_filter_db = -10
	add_child(roar)
	flash = _glow("MoonFlash", false)
	for index in MAX_METEORS:
		meteors.append({"node":_glow("Meteor" + str(index), true),"start":Vector3.ZERO,"end":Vector3.ZERO,"delay":0.0,"life":1.0})
	cancel()
	set_process(false) # The presented host owns the one animation clock.

func trigger(body: String, eye: Vector3, direction: Vector3) -> bool:
	if body not in DURATION or not eye.is_finite() or not direction.is_finite() or direction.length_squared() < .01: return false
	if not kind.is_empty() or cooldown > 0.0: return false
	if body == "sun":
		route = _plan_route(eye)
		if route.is_empty(): return false
	kind = body; age = 0.0; cooldown = COOLDOWN; accepted += 1
	_eye = eye; _moon = direction.normalized(); shower = false
	if body == "sun":
		_monster_site = route.start; _monster_end = route.end
		monster.position = _monster_site
		var toward := Vector3(eye.x-_monster_site.x,0,eye.z-_monster_site.z).normalized()
		# Show a profile from the triggering viewer, rather than a gorilla-like
		# frontal chest. Keep that world heading if the observer subsequently walks.
		monster.look_at(_monster_site+Vector3(-toward.z,0,toward.x)*float(route.side))
		monster.scale = Vector3.ONE * 5.0
		roar.position = _monster_site + Vector3.UP * 100.0
		if roar.stream: roar.play()
	else:
		shower = random.randf() < SHOWER_CHANCE
		var count := (3 if low_end else MAX_METEORS) if shower else 1
		# A small tangent-plane arc around the moon, including when it is overhead.
		# Store eye-relative positions so it follows the sky as the viewer walks.
		var right := _moon.cross(Vector3.UP).normalized()
		if right.length_squared()<.5: right=Vector3.RIGHT
		var up := right.cross(_moon).normalized()
		var centre := _moon*280.0
		var lift := maxf(0.0,14.0-centre.y)
		for index in MAX_METEORS:
			var item: Dictionary = meteors[index]
			item.enabled = index < count
			item.start = centre+right*36.0+up*(24.0+index*3.0+lift)
			item.end = centre-right*36.0+up*(4.0+index*3.0+lift)
			item.delay = .45 + index * .5
			item.life = 1.15 + index * .08
	advance(0.0, eye)
	return true

func advance(delta: float, eye: Vector3) -> void:
	if not is_finite(delta) or delta < 0: return
	cooldown = maxf(0.0, cooldown - delta)
	if kind.is_empty(): return
	age += delta
	if eye.is_finite(): _eye = eye
	if age >= float(DURATION[kind]): cancel(false); return
	if kind == "sun":
		monster.visible = true
		var rise := smoothstep(0.0, 1.65, age) * (1.0 - smoothstep(4.7, 7.0, age))
		var swim := smoothstep(.6,6.8,age)
		monster.position = _monster_site.lerp(_monster_end,swim) + Vector3(0, -175.0 + rise * 145.0, 0)
		monster.rotation.z = sin(age * 1.3) * .025 * rise
		roar.position = monster.position + Vector3.UP*130.0
	else:
		var pulse := sin(clampf(age / .4, 0.0, 1.0) * PI) * .65
		flash.visible = pulse > .001
		flash.position = _eye + _moon * 280.0
		flash.scale = Vector3(10,10,1)
		flash.look_at(_eye, Vector3.FORWARD if absf(_moon.y) > .98 else Vector3.UP)
		(flash.material_override as ShaderMaterial).set_shader_parameter("strength", pulse)
		for item in meteors:
			var t: float = (age - item.delay) / item.life
			var node: MeshInstance3D = item.node
			node.visible = item.get("enabled", false) and t >= 0.0 and t < 1.0
			if not node.visible: continue
			node.position = _eye+(item.start as Vector3).lerp(item.end, t)
			var toward := (_eye - node.position).normalized()
			var axis: Vector3 = ((item.end as Vector3) - item.start).slide(toward).normalized()
			var up := toward.cross(axis).normalized()
			node.basis = Basis(axis * 22.0, up * 1.8, toward)
			(node.material_override as ShaderMaterial).set_shader_parameter("strength", sin(t * PI) * 1.25)

func cancel(reset_cooldown: bool = true) -> void:
	kind = ""; age = 0.0
	if reset_cooldown: cooldown = 0.0
	if monster: monster.visible = false
	if flash: flash.visible = false
	if roar: roar.stop()
	for item in meteors: item.node.visible = false

func _exit_tree() -> void:
	if roar: roar.stop()

func _glow(label: String, streak: bool) -> MeshInstance3D:
	var node := MeshInstance3D.new(); node.name = label
	var quad := QuadMesh.new(); quad.size = Vector2.ONE
	node.mesh = quad; node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	var material := ShaderMaterial.new(); material.shader = Glow; material.set_shader_parameter("streak", streak)
	node.material_override = material; add_child(node)
	return node

