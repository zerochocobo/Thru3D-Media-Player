// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
shader_type spatial;
render_mode unshaded, cull_front, shadows_disabled, fog_disabled;
#include "res://shaders/private_beach/time_sky_common.gdshaderinc"
uniform mat3 orientation = mat3(1.0);
varying vec3 world_direction;
vec3 backdrop_encode(vec3 color) {
	return mix(color*12.92,1.055*pow(max(color,vec3(0)),vec3(1.0/2.4))-.055,step(vec3(.0031308),color));
}
void vertex() { world_direction=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz-CAMERA_POSITION_WORLD; }
