// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
shader_type spatial;
render_mode unshaded, cull_back;
#include "res://shaders/private_beach/common.gdshaderinc"
#include "res://shaders/private_beach/sky_texture.gdshaderinc"
uniform sampler2D day_reflection : source_color,filter_linear_mipmap,repeat_enable;
uniform sampler2D beach_micro_color : source_color,filter_linear_mipmap_anisotropic,repeat_enable;
uniform sampler2D beach_macro_color : source_color,filter_linear_mipmap_anisotropic,repeat_enable;
varying vec3 world_position;
vec3 reflected_sky(vec3 direction) {
	float height=pow(clamp(direction.y,0.0,1.0),.45);
	vec3 night=mix(vec3(.008,.014,.031),vec3(.001,.003,.012),height);
	vec3 day=vec3(0.0);
	if (day_mix>0.0) {
		day=sample_beach_panorama(day_reflection,direction);
		if (OUTPUT_IS_SRGB) day=decode_srgb(day);
	}
	return mix(night,day,day_mix);
}
void vertex() {
	vec3 p=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;
	float inland=p.z-shore_z(p.x);
	float wave=sin(p.z*.75+study_time*.8+sin(p.x*.24))*.012;
	wave*=1.0-smoothstep(18.0,35.0,-inland);
	// The shared coast-following mesh carries the static shore slope. Rebuilding
	// height from a coarse rectangular ocean grid would lift offshore triangles
	// toward dry vertices when the coastline turns around a headland.
	VERTEX.y+=.008+wave*smoothstep(0.0,2.0,-inland);
	world_position=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;
}
void fragment() {
	float inland=world_position.z-shore_z(world_position.x);
	float swash=swash_front(world_position.x);
	vec2 projected_width=fwidth(world_position.xz);
	if (inland>swash) discard;
	float far_fade=1.0-smoothstep(30.0,130.0,distance(CAMERA_POSITION_WORLD,world_position));
	float phase1=dot(world_position.xz,vec2(.68,.49))+study_time*.65;
	float phase2=dot(world_position.xz,vec2(-.47,.63))+study_time*.49;
	float phase3=dot(world_position.xz,vec2(.23,1.17))+study_time*.83;
	float aa1=1.0-smoothstep(.5,2.5,dot(projected_width,vec2(.68,.49)));
	float aa2=1.0-smoothstep(.5,2.5,dot(projected_width,vec2(.47,.63)));
	float aa3=1.0-smoothstep(.5,2.5,dot(projected_width,vec2(.23,1.17)));
	float nx=cos(phase1)*.0068*aa1-cos(phase2)*.0047*aa2+cos(phase3)*.0012*aa3;
	float nz=cos(phase1)*.0049*aa1+cos(phase2)*.0063*aa2+cos(phase3)*.0058*aa3;
	vec3 n=normalize(vec3(nx*far_fade,1.0,nz*far_fade));
	vec3 view_dir=normalize(CAMERA_POSITION_WORLD-world_position);
	float fresnel=.025+.975*pow(1.0-max(dot(n,view_dir),0.0),5.0);
	vec3 reflection=reflected_sky(reflect(-view_dir,n));
	vec3 sea=mix(vec3(.003,.018,.028),vec3(.018,.16,.20),day_mix);
	float visible=sun_visibility(world_position)*static_ground_visibility(world_position,vec2(1.0)).g;
	// Resolve the shallow bed with the same sand scans and light split; thin water
	// should reveal wet sand instead of ending in an opaque turquoise strip.
	if (inland>-4.0) {
		// Share the dry/wet bed's world-anchored patch choice.
		vec3 fine=beach_surface(beach_micro_color,world_position.xz/2.0,beach_patch(vec3(world_position.x,0.0,world_position.z)));
		vec3 broad=texture(beach_macro_color,world_position.xz/30.0).rgb;
		if (OUTPUT_IS_SRGB) { fine=decode_srgb(fine); broad=decode_srgb(broad); }
		vec3 bed=fine*mix(1.15,1.65,clamp(dot(broad,vec3(.2126,.7152,.0722))*2.5,0.0,1.0))*.46;
		vec3 bed_ambient=mix(vec3(.10,.14,.22),vec3(.34,.40,.46),day_mix)*static_ground_visibility(world_position,vec2(1.0)).r;
		float bed_sun=max(sun_direction.y,0.0)*visible*day_mix;
		bed*=bed_ambient+vec3(1.35,1.25,1.05)*bed_sun+local_light(world_position,vec3(0,1,0));
		sea=mix(sea,bed,smoothstep(-4.0,.5,inland));
	}
	vec3 color=mix(sea,reflection,fresnel*mix(.85,.18,smoothstep(-1.0,1.0,inland)));
	vec3 half_dir=normalize(sun_direction+view_dir);
	float sun_spec=pow(max(dot(n,half_dir),0.0),180.0)*visible*day_mix;
	color+=vec3(1.3,1.15,.9)*sun_spec;
	// Low-contrast broken foam, with a projected-pixel soft edge. World-space
	// noise advects slowly with the swash, never with the viewer's head.
	float edge=swash-inland;
	float foam=0.0;
	if (edge<1.3) {
		vec2 flow=mat2(vec2(.8,.6),vec2(-.6,.8))*world_position.xz+vec2(0,study_time*.08);
		float patch=foam_noise(flow*4.0)*.65+foam_noise(flow*8.7+vec2(11.0,3.0))*.35;
		float width=mix(.35,.85,foam_noise(vec2(world_position.x*.55,study_time*.08)));
		float pixel_width=max(.065,length(projected_width));
		float front=smoothstep(0.0,pixel_width,edge)*(1.0-smoothstep(width-pixel_width,width+pixel_width,edge));
		foam=front*smoothstep(.42,.72,patch)*.23;
	}
	vec3 foam_light=mix(vec3(.015,.025,.045),vec3(.30,.36,.40),day_mix)+vec3(.9,.85,.75)*visible*day_mix;
	color=mix(color,foam_light,foam);
	color+=local_light(world_position,n)*.15;
	ALBEDO=debug_shadow_mask ? vec3(sun_visibility(world_position)) : (OUTPUT_IS_SRGB ? encode_srgb(color) : color);
}
