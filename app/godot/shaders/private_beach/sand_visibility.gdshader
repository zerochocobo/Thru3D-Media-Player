// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
shader_type spatial;
render_mode unshaded, cull_disabled, fog_disabled, shadows_disabled;
// Top-down bake of the sand's ground visibility around the viewer: R ambient
// (static atlas), G moving sun. Drawn only when the sun or the focus moves, so
// the sand reads one texel instead of the atlas tiles and two PCF cascades.
#include "res://shaders/private_beach/common.gdshaderinc"
#include "res://shaders/private_beach/moving_shadow.gdshaderinc"
varying vec3 world_position;
varying vec3 world_normal;
void vertex() {
	world_position=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;
	world_normal=normalize(MODEL_NORMAL_MATRIX*NORMAL);
}
void fragment() {
	vec2 fixed_visibility=static_ground_visibility(world_position,COLOR.gb);
	float moving=moving_visibility(world_position,normalize(world_normal));
	ALBEDO=vec3(fixed_visibility.r,moving,0.0);
}
