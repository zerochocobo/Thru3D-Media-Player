// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
shader_type spatial;
render_mode unshaded,cull_disabled,fog_disabled;
uniform bool cutout = false;
uniform sampler2D leaf_alpha : filter_linear_mipmap;
varying float light_depth;
void vertex() { light_depth=-(MODELVIEW_MATRIX*vec4(VERTEX,1.0)).z/1000.0; }
void fragment() {
	if (cutout && UV.x>=0.0 && texture(leaf_alpha,UV).r<.45) discard;
	float depth=clamp(light_depth,0.0,.99999);
	// The renderer's transfer reads up to 3/255 low below about .17, enough to
	// misdecode a digit, so stay above it. Measured error here is under 1/255.
	// 18 bits over 1000 metres still resolve about 3.8 mm of light-space depth.
	uint code=uint(depth*262143.0+.5);
	vec3 digits=vec3(float((code>>12u)&63u),float((code>>6u)&63u),float(code&63u));
	ALBEDO=vec3(.25)+digits*(.625/63.0);
}
