// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
shader_type spatial;
render_mode unshaded, blend_add, depth_draw_never, cull_disabled, fog_disabled, shadows_disabled;
// Procedural flame tongue on a Y-axis billboard. Small on screen, so a few
// value-noise octaves stay cheap; nothing here is sampled from a texture.
uniform float flame_time = 0.0;
uniform float flame_seed = 0.0;
uniform float intensity : hint_range(0,1) = 1.0;
float flame_hash(vec2 p) { return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
float flame_noise(vec2 p) {
	vec2 cell=floor(p),f=fract(p);
	f=f*f*(3.0-2.0*f);
	return mix(mix(flame_hash(cell),flame_hash(cell+vec2(1,0)),f.x),mix(flame_hash(cell+vec2(0,1)),flame_hash(cell+vec2(1,1)),f.x),f.y);
}
void vertex() {
	// Face the camera around the vertical axis; flames stay upright.
	vec3 to_camera=CAMERA_POSITION_WORLD-(MODEL_MATRIX*vec4(0,0,0,1)).xyz;
	vec3 forward=normalize(vec3(to_camera.x,0.0,to_camera.z));
	vec3 right=vec3(forward.z,0.0,-forward.x);
	vec3 world=(MODEL_MATRIX*vec4(0,0,0,1)).xyz+right*VERTEX.x*length(MODEL_MATRIX[0].xyz)+vec3(0,1,0)*VERTEX.y*length(MODEL_MATRIX[1].xyz);
	POSITION=PROJECTION_MATRIX*VIEW_MATRIX*vec4(world,1.0);
}
void fragment() {
	vec2 uv=vec2(UV.x-.5,1.0-UV.y);
	float t=flame_time*1.6+flame_seed*7.0;
	float turbulence=flame_noise(vec2(uv.x*5.0+flame_seed*3.0,uv.y*3.2-t*1.7))*.6+flame_noise(vec2(uv.x*11.0,uv.y*7.0-t*3.1))*.4;
	float sway=(turbulence-.5)*.22*uv.y;
	// Teardrop: wide at the embers, licking narrow toward the top.
	float width=mix(.34,.04,pow(uv.y,.8));
	float body=1.0-smoothstep(width*.55,width,abs(uv.x-sway));
	float rise=smoothstep(0.0,.08,uv.y)*(1.0-smoothstep(.45,1.0,uv.y+turbulence*.35));
	float heat=clamp(body*rise*(.75+.5*turbulence),0.0,1.0);
	vec3 color=mix(vec3(.85,.16,.02),vec3(1.0,.62,.18),smoothstep(.25,.7,heat));
	color=mix(color,vec3(1.0,.9,.62),smoothstep(.75,1.0,heat)*(1.0-uv.y));
	ALBEDO=color*heat*intensity*1.6;
	ALPHA=heat*intensity;
}
