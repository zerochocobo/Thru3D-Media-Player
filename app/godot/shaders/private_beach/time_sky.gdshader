// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
shader_type sky;
#include "res://shaders/private_beach/time_sky_common.gdshaderinc"
// Sky shaders lack spatial OUTPUT_IS_SRGB. Authoring host sets the renderer.
uniform bool sky_output_srgb = true;
uniform bool cloud_coverage_debug = false;
void sky() {
	if (cloud_coverage_debug) {
		COLOR=vec3(time_cloud_cover(normalize(EYEDIR)));
	} else {
	vec3 color=time_sky_linear(normalize(EYEDIR),true);
	if (sky_output_srgb) color=mix(color*12.92,1.055*pow(max(color,vec3(0)),vec3(1.0/2.4))-.055,step(vec3(.0031308),color));
	COLOR=color;
	}
}
