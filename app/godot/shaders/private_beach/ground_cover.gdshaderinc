// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
// Optional coastal groundcover. Called only by the standalone vegetation study.
// One physical 2m scan with color/normal samples; no geometry displacement.
uniform sampler2D groundcover_color : source_color,filter_linear_mipmap_anisotropic,repeat_enable;
uniform sampler2D groundcover_normal : hint_normal,filter_linear_mipmap_anisotropic,repeat_enable;
uniform float groundcover_tile = 2.0;
void coastal_groundcover(vec3 p,vec3 geometric_normal,float rock,float eye_distance,inout vec3 albedo,inout vec3 normal) {
	// Broad soil pockets and finer broken margins replace a constant-height band.
	float soil=foam_noise(p.xz*.055+vec2(6.7,13.1));
	float margin=foam_noise(p.xz*.38+vec2(17.3,4.2));
	float cover=smoothstep(.65+margin*.7,1.8+soil*1.1,p.y)
		*smoothstep(.53,.82,geometric_normal.y)
		*mix(.20,1.0,smoothstep(.28,.55,soil+(.5-margin)*.22))*rock;
	vec2 uv=p.xz/groundcover_tile;
	vec2 dx=dFdx(uv),dy=dFdy(uv);
	BeachPatch patch=beach_patch(p*.71+vec3(9.3,0,2.8));
	if (cover>.001) {
		vec3 color=beach_rock_surface(groundcover_color,uv,dx,dy,patch,false,true);
		if (OUTPUT_IS_SRGB) color=decode_srgb(color);
		color*=mix(vec3(.55,.60,.32),vec3(.32,.60,.28),smoothstep(.25,.70,soil))*mix(.72,1.08,soil);
		albedo=mix(albedo,color,cover);
		float detail=1.0-smoothstep(18.0,65.0,eye_distance);
		if (detail>0.0) {
			vec3 scan=beach_rock_surface(groundcover_normal,uv,dx,dy,patch,true,true)*2.0-1.0;
			// Gradient projection keeps both sides of the bay oriented correctly.
			vec3 gradient=vec3(scan.x,0,scan.y)/max(scan.z,.35);
			gradient-=geometric_normal*dot(geometric_normal,gradient);
			normal=normalize(mix(normal,normalize(geometric_normal+gradient*.30),cover*detail));
		}
	}
}
