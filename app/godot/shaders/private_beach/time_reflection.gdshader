// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
shader_type spatial;
render_mode unshaded,cull_back;
#include "res://shaders/private_beach/time_sky_common.gdshaderinc"
varying vec3 world_position;
void vertex() { world_position=(MODEL_MATRIX*vec4(VERTEX,1)).xyz; }
void fragment() {
	vec3 view=normalize(CAMERA_POSITION_WORLD-world_position);
	// Flat reflection calibration; the full beach keeps its spectral waves.
	vec3 n=vec3(0,1,0);
	vec3 reflection=time_sky_linear(reflect(-view,n),true);
	float fresnel=.025+.975*pow(1.0-max(dot(n,view),0.0),5.0);
	float day=smoothstep(-.10,.22,time_sun_direction.y);
	vec3 color=mix(mix(vec3(.001,.004,.008),vec3(.008,.055,.07),day),reflection,fresnel);
	// Compatibility spatial unshaded material writes display values.
	if (OUTPUT_IS_SRGB) color=mix(color*12.92,1.055*pow(max(color,vec3(0)),vec3(1.0/2.4))-.055,step(vec3(.0031308),color));
	ALBEDO=color;
}
