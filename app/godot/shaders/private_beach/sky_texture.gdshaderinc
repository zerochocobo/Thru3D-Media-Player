// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
// Shared world-to-panorama mapping for the visible sky and reflected sky.
vec3 sample_beach_panorama(sampler2D panorama, vec3 direction) {
	vec2 uv=vec2(atan(direction.x,direction.z)/6.2831853+.5,acos(clamp(direction.y,-1.0,1.0))/3.14159265);
	float half_texel=.5/float(textureSize(panorama,0).y);
	uv.y=clamp(uv.y,half_texel,1.0-half_texel);
	vec2 dx=dFdx(uv); vec2 dy=dFdy(uv);
	// Longitude wraps; its seam must not select a whole-panorama mip.
	dx.x-=round(dx.x); dy.x-=round(dy.x);
	return textureGrad(panorama,uv,dx,dy).rgb;
}
