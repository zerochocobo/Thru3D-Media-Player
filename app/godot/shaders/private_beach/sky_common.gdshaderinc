// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
uniform float day_mix = 1.0;
uniform bool stars_enabled = true;
uniform bool stable_dither = true;
uniform sampler2D day_panorama : source_color, filter_linear_mipmap, repeat_enable;
#include "res://shaders/private_beach/sky_texture.gdshaderinc"
float hash(vec2 p) { return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
vec3 beach_sky(vec3 direction) {
	float h=pow(clamp(direction.y,0.0,1.0),.45);
	vec3 day=vec3(0.0);
	if (day_mix>0.0) {
		day=sample_beach_panorama(day_panorama,direction);
	}
	vec3 night=mix(vec3(.055,.08,.13),vec3(.009,.019,.05),h);
	if (day_mix<1.0) {
		vec2 p=vec2(atan(direction.x,direction.z)/6.2831853+.5,asin(clamp(direction.y,-1.0,1.0))/3.14159265+.5)*vec2(1024.0,512.0);
		if (stars_enabled) {
			vec2 cell=floor(p);
			vec2 center=vec2(.25+.5*hash(cell),.25+.5*hash(cell+17.0));
			float radius=.07+.08*hash(cell+23.0);
			float footprint=max(length(fwidth(p)),.05);
			float star=(1.0-smoothstep(radius,radius+footprint,length(fract(p)-center)))*step(.995,hash(cell+49.0));
			star*=min(1.0,radius*radius/(footprint*footprint))*smoothstep(.02,.15,direction.y);
			night+=vec3(star*.9);
		}
		// World-direction-stable dither, no temporal hash or per-pixel star-list traversal.
		if (stable_dither) night+=vec3((hash(floor(p*64.0))-.5)/255.0);
	}
	return mix(night,day,day_mix);
}
