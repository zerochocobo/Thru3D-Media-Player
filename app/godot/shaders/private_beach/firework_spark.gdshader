// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
shader_type spatial;
render_mode unshaded,blend_add,depth_draw_never,cull_disabled;
// Instance origin: x = trail delay, y = 0 star / 1 rocket / 2 burst flash,
// z = 0 first burst / 1 second burst of a salvo. Custom rgb = velocity, a = random.
uniform float age = 0.0;
uniform float flight_time = 1.4;
uniform vec3 launch;
uniform vec3 launch2;
uniform vec3 burst;
uniform vec3 burst2;
uniform float second_delay = 0.0;
uniform float speed = 13.0;
uniform float drag = 1.1;
uniform float gravity = 9.8;
uniform float lifetime = 3.0;
uniform float trail_scale = 1.0;
uniform vec3 shift_color = vec3(1.0);
uniform float shift_at = 2.0;
uniform float twinkle = 0.0;
uniform float flash_size = 9.0;
uniform float scene_visibility = 1.0;
uniform vec2 spark_radius = vec2(.46,.12);
varying float spark_alpha;
varying vec3 spark_color;
varying float flash;
float spark_hash(float x) { return fract(sin(x*12.9898)*43758.5453); }
vec3 rocket_at(vec3 origin,vec3 target,float t) {
	return mix(origin,target,t/flight_time)+vec3(0,4.9*t*(flight_time-t),0);
}
vec3 star_at(vec3 origin,vec3 initial_velocity,float t) {
	float integrated=(1.0-exp(-drag*t))/drag;
	return origin+initial_velocity*integrated-vec3(0,gravity*(t-integrated)/drag,0);
}
void vertex() {
	float kind=MODEL_MATRIX[3].y;
	bool second=MODEL_MATRIX[3].z>.5;
	float delay=MODEL_MATRIX[3].x*trail_scale;
	float offset=second ? second_delay : 0.0;
	vec3 target=second ? burst2 : burst;
	vec3 origin=second ? launch2 : launch;
	vec3 center;
	vec3 previous;
	vec3 velocity;
	float radius;
	flash=0.0;
	spark_color=COLOR.rgb;
	vec3 forward=INV_VIEW_MATRIX[2].xyz;
	if (kind>1.5) {
		// A short white-gold flash where the shell breaks.
		float since=age-flight_time-offset;
		spark_alpha=step(0.0,since)*exp(-since*13.0)*COLOR.a;
		radius=flash_size*(.9+min(since,.3)*1.5);
		vec3 right=INV_VIEW_MATRIX[0].xyz,up=INV_VIEW_MATRIX[1].xyz;
		vec3 world=target+right*VERTEX.x*radius*2.0+up*(UV.y-.5)*radius*2.0;
		flash=1.0; spark_color=vec3(1.0,.9,.72);
		POSITION=PROJECTION_MATRIX*VIEW_MATRIX*vec4(world,1.0);
	} else {
		if (kind>.5) {
			float t=clamp(age-offset-delay,0.0,flight_time);
			center=rocket_at(origin,target,t);
			previous=rocket_at(origin,target,max(0.0,t-.035));
			velocity=(target-origin)/flight_time+vec3(0,4.9*(flight_time-2.0*t),0);
			// Colour alpha switches the second rocket off unless the shell is a salvo.
			spark_alpha=step(offset+delay,age)*(1.0-smoothstep(flight_time,flight_time+.12,age-offset))*exp(-delay*7.0)*COLOR.a;
			radius=.08+.04*exp(-delay*8.0);
			spark_color=vec3(1,.67,.27);
		} else {
			float t=max(0.0,age-flight_time-offset-delay);
			vec3 initial_velocity=(INSTANCE_CUSTOM.rgb*2.0-1.0)*speed;
			center=star_at(target,initial_velocity,t);
			previous=star_at(target,initial_velocity,max(0.0,t-.045*trail_scale));
			velocity=initial_velocity*exp(-drag*t)-vec3(0,gravity*(1.0-exp(-drag*t))/drag,0);
			float life=lifetime*(.6+.4*INSTANCE_CUSTOM.a);
			spark_alpha=step(flight_time+offset+delay,age)*(1.0-smoothstep(life*.5,life,t))*exp(-MODEL_MATRIX[3].x*5.0)*COLOR.a;
			// Burning stars start white-hot, settle into their colour, then may change hue.
			spark_color=mix(vec3(1.0,.93,.8),COLOR.rgb,smoothstep(0.0,.3,t));
			spark_color=mix(spark_color,shift_color,smoothstep(shift_at*life,(shift_at+.12)*life,t));
			if (twinkle>0.0 && t>life*.3) {
				float blink=step(.45,spark_hash(floor(age*16.0)+INSTANCE_CUSTOM.a*311.0));
				spark_alpha*=mix(1.0,blink*1.6,twinkle);
			}
			radius=(spark_radius.x+spark_radius.y*INSTANCE_CUSTOM.a)*(1.0+.25*MODEL_MATRIX[3].x);
		}
		vec3 projected=velocity-forward*dot(velocity,forward);
		float length_v=length(projected);
		vec3 along=length_v>.0001 ? projected/length_v : INV_VIEW_MATRIX[1].xyz;
		vec3 across=normalize(cross(along,forward));
		// Adjacent quads share actual ballistic endpoints. Independent tapered
		// billboards made a dashed chain when enlarged for distant festival shells.
		vec3 world=mix(previous,center,UV.y)+across*VERTEX.x*radius*2.0;
		POSITION=PROJECTION_MATRIX*VIEW_MATRIX*vec4(world,1.0);
	}
}
void fragment() {
	vec2 p=abs(UV*2.0-1.0);
	if (flash>.5) {
		float r=length(UV*2.0-1.0);
		ALBEDO=spark_color;
		float fall=1.0-smoothstep(0.0,1.0,r);
		ALPHA=clamp(fall*fall*fall,0.0,1.0)*spark_alpha*scene_visibility*.45;
	} else {
		float glow=exp(-p.x*p.x*5.0);
		float core=1.0-smoothstep(.12,.45,p.x);
		// Keep the emitter hue in the bright core. Broad white mixing clipped the
		// coloured festival shells into the same white streaks in the LDR renderer.
		ALBEDO=mix(spark_color,vec3(1.0),core*.035)*1.05;
		ALPHA=clamp(glow*.35+core*.85,0.0,1.0)*spark_alpha*scene_visibility;
	}
}
