// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
shader_type spatial;
render_mode unshaded,blend_add,depth_draw_never,cull_disabled;
uniform float age = 0.0;
uniform float flight_time = 1.4;
uniform vec3 launch;
uniform vec3 burst;
uniform float speed = 13.0;
uniform float drag = 1.1;
uniform float lifetime = 3.0;
uniform float scene_visibility = 1.0;
uniform vec2 spark_radius = vec2(.46,.12);
varying float spark_alpha;
void vertex() {
	float delay=MODEL_MATRIX[3].x;
	bool rocket=MODEL_MATRIX[3].y>.5;
	vec3 center;
	vec3 previous;
	vec3 velocity;
	float radius;
	if (rocket) {
		float t=clamp(age-delay,0.0,flight_time);
		center=mix(launch,burst,t/flight_time)+vec3(0,4.9*t*(flight_time-t),0);
		float old_t=max(0.0,t-.035);
		previous=mix(launch,burst,old_t/flight_time)+vec3(0,4.9*old_t*(flight_time-old_t),0);
		velocity=(burst-launch)/flight_time+vec3(0,4.9*(flight_time-2.0*t),0);
		spark_alpha=step(delay,age)*(1.0-smoothstep(flight_time,flight_time+.12,age))*exp(-delay*7.0);
		radius=.08+.04*exp(-delay*8.0);
	} else {
		float t=max(0.0,age-flight_time-delay);
		float integrated=(1.0-exp(-drag*t))/drag;
		vec3 initial_velocity=(INSTANCE_CUSTOM.rgb*2.0-1.0)*speed;
		center=burst+initial_velocity*integrated-vec3(0,9.8*(t-integrated)/drag,0);
		float old_t=max(0.0,t-.045);
		float old_integrated=(1.0-exp(-drag*old_t))/drag;
		previous=burst+initial_velocity*old_integrated-vec3(0,9.8*(old_t-old_integrated)/drag,0);
		velocity=initial_velocity*exp(-drag*t)-vec3(0,9.8*integrated,0);
		float life=lifetime*(.7+.3*INSTANCE_CUSTOM.a);
		spark_alpha=step(flight_time+delay,age)*(1.0-smoothstep(life*.55,life,t))*exp(-delay*5.0);
		radius=(spark_radius.x+spark_radius.y*INSTANCE_CUSTOM.a)*(1.0+.25*delay);
	}
	vec3 forward=INV_VIEW_MATRIX[2].xyz;
	vec3 projected=velocity-forward*dot(velocity,forward);
	float length_v=length(projected);
	vec3 along=length_v>.0001 ? projected/length_v : INV_VIEW_MATRIX[1].xyz;
	vec3 across=normalize(cross(along,forward));
	// Adjacent quads share actual ballistic endpoints. Independent tapered
	// billboards made a dashed chain when enlarged for distant festival shells.
	vec3 world=mix(previous,center,UV.y)+across*VERTEX.x*radius*2.0;
	POSITION=PROJECTION_MATRIX*VIEW_MATRIX*vec4(world,1.0);
}
void fragment() {
	vec2 p=abs(UV*2.0-1.0);
	float glow=exp(-p.x*p.x*5.0);
	float core=1.0-smoothstep(.12,.45,p.x);
	// Keep the emitter hue in the bright core. Broad white mixing clipped the
	// coloured festival shells into the same white streaks in the LDR renderer.
	ALBEDO=mix(COLOR.rgb,vec3(1.0),core*.035)*1.05;
	ALPHA=clamp(glow*.35+core*.85,0.0,1.0)*spark_alpha*scene_visibility;
}
