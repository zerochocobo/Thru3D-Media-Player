// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
// NASA SVS CGI Moon Kit, source credit in tools/beach/source/moon/CREDITS.txt.
// Fixed near-side full moon follows the existing artistic opposite-sun orbit.
uniform sampler2D moon_albedo : filter_linear_mipmap,repeat_disable;
uniform bool moon_detail_enabled = true;
const float MOON_RADIUS = .0045;

vec3 time_moon_surface(vec3 direction,float footprint) {
	if (!moon_detail_enabled) return vec3(.70,.77,.85);
	// The orbit reaches 65 degrees, so the world-up tangent never degenerates.
	vec3 right=normalize(cross(time_moon_direction,vec3(0,1,0)));
	vec3 up=cross(right,time_moon_direction);
	vec2 p=vec2(dot(direction,right),dot(direction,up))/MOON_RADIUS;
	float z=sqrt(max(0.0,1.0-dot(p,p)));
	// 0 longitude is the map centre; project onto the visible lunar hemisphere.
	vec2 uv=vec2(.5+atan(p.x,max(z,.00001))/6.283185307,.5-asin(clamp(p.y,-1.0,1.0))/3.141592654);
	// Explicit angular footprint avoids undefined texture derivatives in the
	// tiny disc branch and keeps the distant moon stable when moving the head.
	float lod=clamp(log2(max(1.0,footprint/MOON_RADIUS*128.0)),0.0,8.0);
	vec3 encoded=textureLod(moon_albedo,uv,lod).rgb;
	vec3 albedo=mix(encoded/12.92,pow((encoded+.055)/1.055,vec3(2.4)),step(vec3(.04045),encoded));
	return albedo*vec3(.90,.94,1.0)*1.4*(.88+.12*z);
}
