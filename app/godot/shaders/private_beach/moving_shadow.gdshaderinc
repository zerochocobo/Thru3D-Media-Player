// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
uniform sampler2D moving_shadow_near : filter_nearest,repeat_disable;
uniform sampler2D moving_shadow_far : filter_nearest,repeat_disable;
uniform mat4 moving_shadow_near_view;
uniform mat4 moving_shadow_far_view;
uniform vec2 moving_shadow_extent = vec2(12.0,520.0);
uniform bool moving_shadow_enabled = true;
uniform bool moving_shadow_debug = false;
uniform bool moving_shadow_sample_debug = false;
uniform vec3 moving_shadow_probe;
float moving_decode(vec3 sample_value) {
	vec3 digits=clamp(floor((sample_value-.25)*(63.0/.625)+.5),vec3(0),vec3(63));
	return dot(digits,vec3(4096,64,1))*(1000.0/262143.0);
}
float moving_compare(sampler2D map,vec2 uv,float depth,float bias) {
	float stored=moving_decode(textureLod(map,uv,0.0).rgb);
	return step(depth-bias,stored);
}
float moving_tap(sampler2D map,vec2 uv,vec3 q,vec3 normal,float extent,float bias) {
	vec2 delta=(vec2(uv.x,1.0-uv.y)-.5)*extent-q.xy;
	float nz=abs(normal.z)>.02 ? normal.z : (normal.z<0.0 ? -.02 : .02);
	float correction=dot(normal.xy,delta)/nz;
	return moving_compare(map,uv,-q.z+correction,bias);
}
float moving_pcf(sampler2D map,vec3 q,float extent,vec3 normal) {
	vec2 uv=vec2(q.x,-q.y)/extent+.5;
	if (any(lessThan(uv,vec2(0))) || any(greaterThan(uv,vec2(1)))) return 1.0;
	float size=float(textureSize(map,0).x);
	float bias=.025+extent/size*.12;
	vec2 pixel=uv*size-.5,weight=fract(pixel),origin=(floor(pixel)+.5)/size;
	vec2 step_uv=vec2(1.0/size,0);
	float a=moving_tap(map,origin,q,normal,extent,bias);
	float b=moving_tap(map,origin+step_uv,q,normal,extent,bias);
	float c=moving_tap(map,origin+step_uv.yx,q,normal,extent,bias);
	float d=moving_tap(map,origin+step_uv+step_uv.yx,q,normal,extent,bias);
	return mix(mix(a,b,weight.x),mix(c,d,weight.x),weight.y);
}
float moving_visibility(vec3 p,vec3 n) {
	if (!moving_shadow_enabled) return 1.0;
	// Use the actual receiver triangle plane, not its interpolated smooth
	// lighting normal. Their small differences become large at grazing sun.
	vec3 face=cross(dFdx(p),dFdy(p));
	if (dot(face,face)>1e-16) n=normalize(face);
	vec3 near_q=(moving_shadow_near_view*vec4(p,1)).xyz;
	vec3 far_q=(moving_shadow_far_view*vec4(p,1)).xyz;
	float edge=moving_shadow_extent.x*.5-max(abs(near_q.x),abs(near_q.y));
	if (edge>=1.0) return moving_pcf(moving_shadow_near,near_q,moving_shadow_extent.x,mat3(moving_shadow_near_view)*n);
	float far_shadow=moving_pcf(moving_shadow_far,far_q,moving_shadow_extent.y,mat3(moving_shadow_far_view)*n);
	if (edge<=0.0) return far_shadow;
	float near_shadow=moving_pcf(moving_shadow_near,near_q,moving_shadow_extent.x,mat3(moving_shadow_near_view)*n);
	return mix(far_shadow,near_shadow,smoothstep(0.0,1.0,edge));
}
