// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
// Shared by visible sky and reflection study. Linear-light output throughout.
#include "res://shaders/private_beach/sky_texture.gdshaderinc"
uniform sampler2D cloud_coverage : filter_linear_mipmap,repeat_enable;
uniform vec4 cloud_motion = vec4(1,0,1,0);
uniform float cloud_density : hint_range(0,1) = 1.0;
uniform vec3 time_sun_direction = vec3(.8,.5,-.2);
uniform vec3 time_moon_direction = vec3(-.8,-.5,.2);
uniform bool time_bodies_enabled = true;
#include "res://shaders/private_beach/moon_surface.gdshaderinc"

float time_hash(vec2 p) { return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453); }
float time_stars(vec3 d) {
	// Cube cells avoid the polar streaks/density singularity of lat-long stars.
	// One bounded candidate per cell, measured in angular direction space.
	vec3 a=abs(d),normal,right,up;
	float face;
	if (a.x>=a.y && a.x>=a.z) {
		normal=vec3(sign(d.x),0,0); right=vec3(0,0,1); up=vec3(0,1,0); face=sign(d.x);
	} else if (a.y>=a.z) {
		normal=vec3(0,sign(d.y),0); right=vec3(1,0,0); up=vec3(0,0,1); face=2.0*sign(d.y);
	} else {
		normal=vec3(0,0,sign(d.z)); right=vec3(1,0,0); up=vec3(0,1,0); face=3.0*sign(d.z);
	}
	vec2 p=(vec2(dot(d,right),dot(d,up))/dot(d,normal)*.5+.5)*256.0;
	vec2 cell=floor(p),key=cell+vec2(face*719.0,face*317.0);
	vec2 jitter=vec2(.25+.5*time_hash(key),.25+.5*time_hash(key+17.0));
	vec2 point=(cell+jitter)/256.0*2.0-1.0;
	vec3 star_direction=normalize(normal+right*point.x+up*point.y);
	float radius=.00015+.00015*time_hash(key+23.0);
	float footprint=max(length(fwidth(d)),.00001);
	float disc=1.0-smoothstep(radius,radius+footprint*.65,length(d-star_direction));
	return disc*min(1.0,radius*radius/(footprint*footprint))*step(.993,time_hash(key+49.0))*smoothstep(.02,.15,d.y);
}
float time_cloud_cover(vec3 d) {
	vec3 ray=vec3(cloud_motion.x*d.x-cloud_motion.y*d.z,d.y,
		cloud_motion.y*d.x+cloud_motion.x*d.z);
	float weight=smoothstep(.04,.35,d.y)*(1.0-.3*max(d.y,0.0));
	ray=normalize(ray+vec3(cloud_motion.z-1.0,0,cloud_motion.w)*(.035*weight));
	float raw=sample_beach_panorama(cloud_coverage,ray).r;
	return clamp((raw-(1.0-cloud_density))/max(cloud_density,.0001),0.0,1.0)*smoothstep(0.0,.2,cloud_density);
}
// The coverage comes from a photographed sky: its brightness is the clouds' own
// light and shade. Thin edges stay translucent instead of a flat painted patch.
vec2 time_cloud_layer(vec3 d) {
	float cover=time_cloud_cover(d);
	return vec2(smoothstep(0.0,.75,cover)*.85,smoothstep(.1,.95,cover));
}
vec3 time_sky_linear(vec3 d, bool bodies) {
	float elevation=time_sun_direction.y;
	float daylight=smoothstep(-.10,.22,elevation);
	float h=sqrt(clamp(d.y,0.0,1.0));
	float dusk=(1.0-smoothstep(.08,.35,abs(elevation)))*smoothstep(-.20,-.02,elevation);
	float toward=0.0;
	if (dusk>0.0) {
		toward=max(dot(normalize(vec3(d.x,.001,d.z)),normalize(vec3(time_sun_direction.x,.001,time_sun_direction.z))),0.0);
		toward*=toward; toward*=toward;
	}
	vec3 night=mix(vec3(.005,.009,.020),vec3(.0008,.002,.007),h);
	vec3 day=mix(vec3(.38,.53,.65),vec3(.055,.19,.43),h);
	vec3 sky=mix(night,day,daylight);
	vec3 warm=mix(vec3(.70,.23,.075),vec3(.48,.095,.035),smoothstep(0.0,.4,-time_sun_direction.x));
	sky=mix(sky,warm,dusk*(.2+.8*toward)*(1.0-h)*(1.0-h)*.85);
	// Advect only the neutral cloud field; sky, stars and celestial discs stay
	// in their own coordinates. Smooth bounded warping breaks rigid rotation.
	vec2 layer=time_cloud_layer(d);
	float cloud=layer.x;
	vec3 lit=mix(vec3(.008,.012,.023),vec3(.88,.89,.9),daylight);
	vec3 shade=mix(vec3(.004,.006,.012),vec3(.42,.48,.57),daylight);
	vec3 cloud_color=mix(shade,lit,layer.y);
	cloud_color=mix(cloud_color,vec3(.75,.26,.10)*mix(.55,1.0,layer.y),dusk*(.25+.75*toward)*.8);
	sky=mix(sky,cloud_color,cloud);
	if (daylight<1.0 && d.y>.02 && cloud<.98) sky+=vec3(time_stars(d)*.65*(1.0-daylight)*(1.0-cloud));
	// Derivatives stay outside the branch on the disc pixels.
	float aa=max(length(fwidth(d)),.000001);
	float sd=length(d-time_sun_direction),md=length(d-time_moon_direction);
	if (bodies && time_bodies_enabled && (sd<.25 || md<.02)) {
		float sun_disc=1.0-smoothstep(.00465-aa*.5,.00465+aa*.5,sd);
		float moon_disc=1.0-smoothstep(MOON_RADIUS-aa*.5,MOON_RADIUS+aa*.5,md);
		float horizon=smoothstep(-.006,.006,d.y);
		vec3 sunlight=mix(vec3(1.0,.20,.045),vec3(1.0,.94,.79),smoothstep(0.0,.35,elevation));
		float veil=1.0-cloud*.85;
		sky+=sunlight*(sun_disc*3.0+.12*exp(-sd*sd/0.0015))*horizon*veil*smoothstep(-.02,.01,elevation);
		// Modest lunar radiance; no baked halo or decorative oversized moon.
		if (moon_disc>0.0 && daylight<1.0)
			sky+=time_moon_surface(d,aa)*moon_disc*horizon*veil*(1.0-daylight);
	}
	return max(sky,vec3(0.0));
}
