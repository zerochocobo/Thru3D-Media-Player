// Generated by tools/beach/stage_runtime.py; edit tools/beach/shaders.
shader_type spatial;
render_mode unshaded,cull_back;
// Desktop study shared inputs; populated from beach_config.json / layout.json.
uniform float day_mix = 1.0;
uniform float study_time = 0.0;
uniform vec3 sun_direction;
uniform float moving_direct_mix = 1.0;
uniform vec3 moving_specular_tint = vec3(1);
uniform vec3 moving_light_direction = vec3(0.79,0.57,-0.21);
uniform vec3 screen_origin = vec3(0.0,3.26,-6.0);
uniform vec3 screen_right = vec3(1.0,0.0,0.0);
uniform vec3 screen_up = vec3(0.0,1.0,0.0);
uniform vec3 screen_normal = vec3(0.0,0.0,1.0);
uniform vec2 screen_half_size = vec2(5.0,2.8125);
uniform float screen_curve_radius = 0.0;
uniform vec3 screen_emitters[3];
uniform vec3 screen_emitter_normals[3];
uniform vec3 film_color = vec3(0.10,0.16,0.25);
uniform vec3 lamp_position = vec3(5.2,0.8,8.0);
uniform vec2 coast[32];
uniform int coast_count = 7;
uniform float sea_level = -0.35;
uniform float land_slope = 0.05;
uniform float uprush_offset = 2.0;
uniform bool screen_shadow_enabled = true;
uniform bool debug_shadow_mask = false;
uniform bool debug_base_color = false;
uniform bool use_static_mask = false;
uniform sampler2D static_mask : hint_default_white, filter_linear_mipmap, repeat_disable;
uniform int mask_count = 4;
uniform vec4 mask_world[6];
uniform vec4 mask_atlas[6];
// Authored and relocated rock centres. Zero delta keeps the offline study unchanged.
uniform vec4 relocated_rock = vec4(0.0);

vec2 sample_mask(int tile,vec2 xz,vec2 dx,vec2 dy) {
	vec2 local=(xz-mask_world[tile].xy)/mask_world[tile].zw;
	vec2 uv=mask_atlas[tile].xy+local*mask_atlas[tile].zw;
	// Avoid bilinear reads into another tile; feathering handles its world edge.
	vec2 inset=vec2(.5/1024.0);
	uv=clamp(uv,mask_atlas[tile].xy+inset,mask_atlas[tile].xy+mask_atlas[tile].zw-inset);
	vec2 scale=mask_atlas[tile].zw/mask_world[tile].zw*vec2(1.0,-1.0);
	return textureGrad(static_mask,vec2(uv.x,1.0-uv.y),dx*scale,dy*scale).rg;
}
vec2 static_ground_visibility(vec3 p,vec2 fallback) {
	if (!use_static_mask) return fallback;
	// Derivatives precede the per-pixel tile branches, including shore edges.
	vec2 dx=dFdx(p.xz),dy=dFdy(p.xz);
	float clear_old=0.0;
	if (length(relocated_rock.zw-relocated_rock.xy)>.01) {
		vec2 old_distance=abs(p.xz-relocated_rock.xy);
		clear_old=1.0-smoothstep(.75,1.0,max(old_distance.x,old_distance.y));
		vec2 new_distance=abs(p.xz-relocated_rock.zw);
		// Reuse the original 2 m contact patch at its new world position. Clear
		// the isolated old patch, including the coarse atlas underneath it.
		if (max(new_distance.x,new_distance.y)<1.0) p.xz+=relocated_rock.xy-relocated_rock.zw;
	}
	vec2 base_uv=(p.xz-mask_world[0].xy)/mask_world[0].zw;
	if (any(lessThan(base_uv,vec2(0.0))) || any(greaterThan(base_uv,vec2(1.0)))) return fallback;
	vec2 result=sample_mask(0,p.xz,dx,dy);
	for (int i=1; i<6; i++) {
		if (i>=mask_count) break;
		vec2 local=(p.xz-mask_world[i].xy)/mask_world[i].zw;
		float edge=min(min(local.x,local.y),min(1.0-local.x,1.0-local.y));
		if (edge>0.0) result=mix(result,sample_mask(i,p.xz,dx,dy),smoothstep(0.0,.08,edge));
	}
	float edge=min(min(base_uv.x,base_uv.y),min(1.0-base_uv.x,1.0-base_uv.y));
	return mix(mix(fallback,result,smoothstep(0.0,.04,edge)),vec2(1.0),clear_old);
}

// Same polynomial transfers as production cinema_baked_surface.gdshader.
vec3 decode_srgb(vec3 v) {
	vec3 curve = 0.00100836226 + v * (0.0297539691 + v * (0.549324115 + v * (0.553066506 - v * 0.134897133)));
	return mix(v / 12.92, curve, step(vec3(0.04045), v));
}
vec3 encode_srgb(vec3 v) {
	v = clamp(v,0.0,1.0);
	vec3 r = sqrt(v);
	vec3 curve = -0.0360567687 + r * (1.43859379 + r * (-0.921595833 + r * (0.825391838 - r * 0.307939627)));
	return mix(v * 12.92, curve, step(vec3(0.0031308), v));
}
float shore_z(float x) {
	if (x<=coast[0].x) return coast[0].y;
	for (int i=0; i<31; i++) {
		if (i>=coast_count-1) break;
		if (x<=coast[i+1].x) {
			float t = (x-coast[i].x)/(coast[i+1].x-coast[i].x);
			return mix(coast[i].y,coast[i+1].y,t);
		}
	}
	return coast[coast_count-1].y;
}
float curve_shadow_hit(float t,vec3 origin,vec3 direction,float circle_coverage) {
	if (t<=0.0) return 0.0;
	vec3 hit=origin+t*direction;
	float angle=atan(hit.x,screen_curve_radius-hit.z);
	vec2 edge=screen_half_size-vec2(abs(angle*screen_curve_radius),abs(hit.y));
	float soft=.08+t*.006;
	return circle_coverage*smoothstep(-soft,soft,min(edge.x,edge.y));
}
float sun_visibility(vec3 p) {
	if (!screen_shadow_enabled || moving_light_direction.y<=0.0) return 1.0;
	if (screen_curve_radius>0.0) {
		vec3 delta=p-screen_origin;
		vec3 o=vec3(dot(delta,screen_right),dot(delta,screen_up),dot(delta,screen_normal));
		vec3 d=vec3(dot(moving_light_direction,screen_right),dot(moving_light_direction,screen_up),dot(moving_light_direction,screen_normal));
		float a=dot(d.xz,d.xz);
		float b=o.x*d.x+(o.z-screen_curve_radius)*d.z;
		// Expanded form avoids subtracting r*r for nearly flat curves.
		float c=o.x*o.x+o.z*o.z-2.0*screen_curve_radius*o.z;
		float disc=b*b-a*c;
		float aa=max(fwidth(disc)*1.5,.000001);
		float circle_coverage=smoothstep(-aa,aa,disc);
		if (a<.000001 || disc < -aa) return 1.0;
		float q=-b-(b>=0.0 ? 1.0 : -1.0)*sqrt(max(disc,0.0));
		float t0=q/a;
		float t1=abs(q)>.000001 ? c/q : -b/a;
		return 1.0-max(curve_shadow_hit(t0,o,d,circle_coverage),curve_shadow_hit(t1,o,d,circle_coverage));
	}
	float denominator = dot(moving_light_direction,screen_normal);
	if (abs(denominator)<0.02 || moving_light_direction.y<=0.0) return 1.0;
	float t = dot(screen_origin-p,screen_normal)/denominator;
	if (t<=0.0) return 1.0;
	vec3 hit = p+t*moving_light_direction-screen_origin;
	vec2 edge = screen_half_size-abs(vec2(dot(hit,screen_right),dot(hit,screen_up)));
	float soft = 0.08+t*0.006;
	return 1.0-smoothstep(-soft,soft,min(edge.x,edge.y));
}
float swash_phase(float x) {
	return study_time*.52+x*.10+sin(x*.21)*.55+sin(study_time*.13+x*.07)*.18;
}
float swash_front(float x) {
	return (.5+.5*sin(swash_phase(x)))*uprush_offset;
}
float swash_wet_front(float x) {
	float phase=swash_phase(x);
	// Retreat leaves a short-lived darker film; the rising wet edge never
	// leads the water. This is a local recovery approximation, not a tide sim.
	return (.5+.5*max(sin(phase),sin(phase-.9)))*uprush_offset;
}
float foam_noise(vec2 p) {
	vec2 cell=floor(p),f=fract(p);
	f=f*f*(3.0-2.0*f);
	float a=fract(sin(dot(cell,vec2(127.1,311.7)))*43758.5453);
	float b=fract(sin(dot(cell+vec2(1,0),vec2(127.1,311.7)))*43758.5453);
	float c=fract(sin(dot(cell+vec2(0,1),vec2(127.1,311.7)))*43758.5453);
	float d=fract(sin(dot(cell+vec2(1,1),vec2(127.1,311.7)))*43758.5453);
	return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);
}
uniform bool beach_texture_variation = true;
struct BeachPatch {
	vec2 first;
	vec2 second;
	float blend;
};
BeachPatch beach_patch(vec3 position) {
	BeachPatch patch;
	patch.first=vec2(0.0); patch.second=vec2(0.0); patch.blend=0.0;
	if (!beach_texture_variation) return patch;
	float value=foam_noise((position.xz+position.yy*vec2(.61,.37))*.16)*8.0;
	float cell=floor(value);
	patch.first=fract(sin(vec2(cell*127.1+3.7,cell*311.7+9.2))*43758.5453);
	patch.second=fract(sin(vec2((cell+1.0)*127.1+3.7,(cell+1.0)*311.7+9.2))*43758.5453);
	patch.blend=smoothstep(.2,.8,fract(value));
	return patch;
}
vec3 beach_surface(sampler2D source,vec2 uv,BeachPatch patch) {
	// Original UV derivatives keep the mip choice continuous at patch changes.
	vec2 dx=dFdx(uv),dy=dFdy(uv);
	if (!beach_texture_variation) return textureGrad(source,uv,dx,dy).rgb;
	return mix(textureGrad(source,uv+patch.first,dx,dy).rgb,
		textureGrad(source,uv+patch.second,dx,dy).rgb,patch.blend);
}
mat2 rock_patch_rotation(vec2 offset) {
	float turn=floor(offset.x*4.0);
	vec2 axis=turn<1.0 ? vec2(1,0) : (turn<2.0 ? vec2(0,1) : (turn<3.0 ? vec2(-1,0) : vec2(0,-1)));
	return mat2(axis,vec2(-axis.y,axis.x));
}
vec3 beach_rock_surface(sampler2D source,vec2 uv,vec2 dx,vec2 dy,BeachPatch patch,bool normal_map,bool vary) {
	if (!beach_texture_variation) return textureGrad(source,uv,dx,dy).rgb;
	if (!vary) return mix(textureGrad(source,uv+patch.first,dx,dy).rgb,
		textureGrad(source,uv+patch.second,dx,dy).rgb,patch.blend);
	mat2 a=rock_patch_rotation(patch.first),b=rock_patch_rotation(patch.second);
	vec3 first=textureGrad(source,a*uv+patch.first,a*dx,a*dy).rgb;
	vec3 second=textureGrad(source,b*uv+patch.second,b*dx,b*dy).rgb;
	if (normal_map) {
		// Bring sampled slopes back to the original projection axes before
		// triplanar blending; rotating colour alone would detach the relief.
		first=first*2.0-1.0; second=second*2.0-1.0;
		first.xy=transpose(a)*first.xy; second.xy=transpose(b)*second.xy;
		return mix(first,second,patch.blend)*.5+.5;
	}
	return mix(first,second,patch.blend);
}
uniform vec3 moving_sun_color = vec3(1.85,1.68,1.40);
uniform vec3 moving_ambient_color = vec3(.24,.32,.43);
uniform bool legacy_day_lighting = false;
vec3 beach_day_sun() {
	return moving_sun_color;
}
vec3 ambient_irradiance(vec3 normal) {
	// Upper sky plus weaker, warm ground bounce. A constant ambient term
	// erased bevels at night; this hemisphere approximation needs no texture
	// or dynamic light. Night coefficients retain the previous exposure.
	vec3 day_sky=legacy_day_lighting ? vec3(.34,.40,.46) : vec3(.24,.32,.43);
	vec3 sky=moving_ambient_color;
	vec3 ground=sky*vec3(.28,.25,.20);
	return mix(ground,sky,clamp(.5+.5*normal.y,0.0,1.0));
}
vec3 screen_light_sample(vec3 p,vec3 n,vec3 emitter,vec3 facing_normal,float area) {
	vec3 delta=emitter-p;
	float distance2=dot(delta,delta);
	vec3 direction=normalize(delta);
	float facing=max(dot(n,direction),0.0)*max(dot(facing_normal,-direction),0.0);
	return film_color*facing*min(1.8,area/(distance2+1.0));
}
uniform vec3 fire_position = vec3(0.0,-100.0,0.0);
uniform vec3 fire_light = vec3(0.0);
vec3 local_light(vec3 p,vec3 n) {
	vec3 delta = screen_origin-p;
	float distance2 = dot(delta,delta);
	vec3 direction = normalize(delta);
	float facing = max(dot(n,direction),0.0)*max(dot(screen_normal,-direction),0.0);
	vec3 film = film_color*facing*min(1.8,screen_half_size.x*screen_half_size.y/(distance2+1.0));
	if (screen_curve_radius>0.0) {
		film=vec3(0.0);
		for (int i=0;i<3;i++) film+=screen_light_sample(p,n,screen_emitters[i],screen_emitter_normals[i],screen_half_size.x*screen_half_size.y/3.0);
	}
	vec3 lamp_delta = lamp_position-p;
	float lamp = max(dot(n,normalize(lamp_delta)),0.0)/(1.0+dot(lamp_delta,lamp_delta)*2.0);
	vec3 fire_delta = fire_position-p;
	float fire = max(dot(n,normalize(fire_delta))*.75+.25,0.0)/(1.0+dot(fire_delta,fire_delta)*.45);
	return (film+vec3(0.9,0.32,0.065)*lamp)*(1.0-day_mix)+fire_light*fire;
}

uniform int surface_kind = 0;
uniform sampler2D wood_color : source_color,filter_linear_mipmap_anisotropic,repeat_enable;
uniform sampler2D rock_color : source_color,filter_linear_mipmap_anisotropic,repeat_disable;
uniform sampler2D rock_normal : hint_normal,filter_linear_mipmap_anisotropic,repeat_disable;
uniform sampler2D rock_arm : filter_linear_mipmap,repeat_disable;
#include "res://shaders/private_beach/moving_shadow.gdshaderinc"
varying vec3 world_position;
varying vec3 world_normal;
varying vec3 world_tangent;
varying vec3 world_binormal;
varying vec3 props_local;
void vertex() {
	world_position=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;
	world_normal=normalize(MODEL_NORMAL_MATRIX*NORMAL);
	world_tangent=normalize((MODEL_MATRIX*vec4(TANGENT,0.0)).xyz);
	world_binormal=normalize((MODEL_MATRIX*vec4(BINORMAL,0.0)).xyz);
	props_local=day_mix<1.0 ? local_light(world_position,world_normal) : vec3(0.0);
}
void fragment() {
	vec3 n=normalize(world_normal);
	vec3 albedo=vec3(.28,.135,.052);
	float ao=COLOR.r;
	float roughness=.75;
	if (surface_kind==0) {
		albedo=texture(wood_color,UV).rgb;
		if (OUTPUT_IS_SRGB) albedo=decode_srgb(albedo);
	} else if (surface_kind==1) {
		albedo=vec3(.51,.47,.37);
		// Fabric UVs are metres, so thread spacing is independent of pad size.
		vec2 thread=UV/vec2(.0012,.0014);
		// Filter the two diagonal frequencies of sin(u)*sin(v), including the
		// sum frequency that can alias even when each yarn axis is resolvable.
		float difference=thread.x-thread.y;
		float sum=thread.x+thread.y;
		float aa_difference=1.0-smoothstep(.2,.5,fwidth(difference));
		float aa_sum=1.0-smoothstep(.2,.5,fwidth(sum));
		float weave=(cos(difference*6.283185)*aa_difference-cos(sum*6.283185)*aa_sum)*.009;
		albedo*=1.0+weave;
		roughness=.95;
	} else if (surface_kind==2) {
		albedo=vec3(.045,.05,.055); roughness=.4;
	} else if (surface_kind==3) {
		albedo=texture(rock_color,UV).rgb;
		if (OUTPUT_IS_SRGB) albedo=decode_srgb(albedo);
		// Keep the scan's mineral variation while bringing the small foreground
		// stone into the bay's grey rock palette. Source textures stay original.
		albedo=mix(vec3(dot(albedo,vec3(.2126,.7152,.0722))),albedo,.28)*vec3(.75,.80,.85);
		vec3 scan=texture(rock_normal,UV).rgb*2.0-1.0;
		n=normalize(world_tangent*scan.x+world_binormal*scan.y+world_normal*scan.z);
		vec3 arm=texture(rock_arm,UV).rgb;
		ao*=arm.r; roughness=arm.g;
	} else {
		albedo=vec3(.75,.71,.61); roughness=.85;
	}
	vec3 ambient=ambient_irradiance(n)*ao;
	float sun=max(dot(n,moving_light_direction),0.0)*moving_direct_mix;
	if (sun>0.0) sun*=moving_visibility(world_position,normalize(world_normal))*sun_visibility(world_position);
	vec3 color=albedo*(ambient+beach_day_sun()*sun+props_local);
	vec3 half_dir=normalize(moving_light_direction+normalize(CAMERA_POSITION_WORLD-world_position));
	color+=moving_specular_tint*vec3(surface_kind==1 ? .018 : .06)*pow(max(dot(n,half_dir),0.0),mix(90.0,12.0,roughness))*sun;
	if (surface_kind==4) color+=vec3(.9,.42,.12)*(1.0-day_mix);
	if (debug_base_color) color=albedo;
	ALBEDO=OUTPUT_IS_SRGB ? encode_srgb(color) : color;

if (moving_shadow_debug) ALBEDO=vec3(moving_visibility(world_position,normalize(world_normal)));
if (moving_shadow_sample_debug) { vec3 q=(moving_shadow_near_view*vec4(moving_shadow_probe,1)).xyz; float stored=moving_decode(textureLod(moving_shadow_near,vec2(q.x,-q.y)/moving_shadow_extent.x+.5,0.0).rgb); ALBEDO=vec3(clamp((stored+q.z+2.0)/4.0,0.0,1.0),moving_visibility(moving_shadow_probe,vec3(0,1,0)),-q.z/1000.0); }
}