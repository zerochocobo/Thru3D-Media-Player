{
  "manifest_version": 2,
  "name": "Thru3D video handoff",
  "version": "1.19",
  "browser_specific_settings": { "gecko": { "id": "web-video@thru3d.local" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "cookies", "webRequest", "webRequestBlocking", "http://*/*", "https://*/*",
    "https://*.youtube.com/*", "https://*.bilibili.com/*", "https://*.douyin.com/*", "https://*.iesdouyin.com/*",
    "https://*.weibo.com/*", "https://*.weibo.cn/*", "https://*.iqiyi.com/*", "https://*.mgtv.com/*",
    "https://*.qq.com/*", "https://*.youku.com/*", "https://*.vimeo.com/*", "https://*.dailymotion.com/*",
    "https://*.dai.ly/*", "https://*.twitch.tv/*", "https://*.tubitv.com/*", "https://*.redbull.com/*",
    "https://*.redbull.tv/*", "https://*.astalavr.com/*",
    "https://*.tiktok.com/*", "https://*.instagram.com/*", "https://*.facebook.com/*", "https://*.fb.watch/*",
    "https://*.twitter.com/*", "https://*.x.com/*", "https://*.reddit.com/*", "https://*.redd.it/*",
    "https://*.streamable.com/*", "https://*.ted.com/*", "https://*.archive.org/*", "https://*.rumble.com/*",
    "https://*.odysee.com/*", "https://*.nicovideo.jp/*", "https://*.nico.ms/*", "https://*.naver.com/*", "https://*.kakao.com/*"],
  "background": { "scripts": ["background.js", "bilibili.js", "bilibili-response.js", "network.js"], "persistent": true },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["bilibili.js", "media.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
