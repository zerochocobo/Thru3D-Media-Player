+void AndroidVideoFrameProbe::Record(RenderAndroidSurfaceTextureHost* aHost) {
+  const auto generation = aHost->mSurfTex->GetFrameProbeGeneration();
+  const auto timestamp = aHost->mSurfTex->GetFrameProbeTimestamp();
+  if (mHost && (mHost.get() != aHost || mGeneration != generation ||
+                mTimestamp != timestamp)) {
+    mAmbiguous = true;
+  }
+  mHost = aHost;
+  mGeneration = generation;
+  mTimestamp = timestamp;
+}
+
+bool AndroidVideoFrameProbe::Matches() const {
+  return mHost && !mAmbiguous && mGeneration > 0 && mTimestamp >= 0 &&
+         mHost->mProbePtsUs >= 0 && mTimestamp / 1000 == mHost->mProbePtsUs &&
+         mHost->mSurfTex &&
+         mHost->mSurfTex->GetFrameProbeGeneration() == mGeneration &&
+         mHost->mSurfTex->GetFrameProbeTimestamp() == mTimestamp;
+}
