+  gl::ScopedGLState stencil(mGL, LOCAL_GL_STENCIL_TEST, false);
+  gl::ScopedGLState cull(mGL, LOCAL_GL_CULL_FACE, false);
+  GLint vao = 0, arrayBuffer = 0;
+  realGLboolean mask[4];
+  mGL->fGetBooleanv(LOCAL_GL_COLOR_WRITEMASK, mask);
+  mGL->fColorMask(true, true, true, true);
+  mGL->fGetIntegerv(LOCAL_GL_ARRAY_BUFFER_BINDING, &arrayBuffer);
+  const bool hasVao = mGL->IsSupported(gl::GLFeature::vertex_array_object);
+  if (hasVao) {
+    mGL->fGetIntegerv(LOCAL_GL_VERTEX_ARRAY_BINDING, &vao);
+    mGL->fBindVertexArray(0);
+  }
+  auto restore = MakeScopeExit([&] {
+    if (hasVao) mGL->fBindVertexArray(vao);
+    mGL->fBindBuffer(LOCAL_GL_ARRAY_BUFFER, arrayBuffer);
+    mGL->fColorMask(mask[0], mask[1], mask[2], mask[3]);
+  });
+  const auto config =
+      layers::ShaderConfigFromTargetAndFormat(LOCAL_GL_TEXTURE_EXTERNAL, mFormat);
+  return mGL->ReadTexImageHelper()->ReadTexImage(
+      mSurfTex->GetTexName(), LOCAL_GL_TEXTURE_EXTERNAL, aSize,
+      GetTextureTransform(), config.mFeatures);
