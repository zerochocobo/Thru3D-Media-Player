# Build the compositor crop shader from the production eye-buffer shader. This keeps
# projection, per-eye clamps, rotation, grading and AI mask math identical on both paths.
set(pip_shader_directory "${CMAKE_CURRENT_LIST_DIR}/../../app/godot/shaders")
set(pip_sources "")
foreach(pip_variant IN ITEMS video_rvm_pair video_rvm_pair_oes)
    set(pip_path "${pip_shader_directory}/${pip_variant}.gdshader")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${pip_path}")
    file(READ "${pip_path}" pip_code)
    string(REPLACE "\r\n" "\n" pip_code "${pip_code}")
    foreach(pip_include IN ITEMS color_grade video_coordinates video_pip_coordinates sharpness)
        set(pip_include_path "${pip_shader_directory}/${pip_include}.gdshaderinc")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${pip_include_path}")
        file(READ "${pip_include_path}" pip_include_code)
        string(REPLACE "#include \"res://shaders/${pip_include}.gdshaderinc\"" "${pip_include_code}" pip_code "${pip_code}")
    endforeach()
    string(FIND "${pip_code}" "void vertex()" pip_vertex)
    string(FIND "${pip_code}" "void fragment() {" pip_fragment)
    string(FIND "${pip_code}" "\tif (!separate_subtitles) {" pip_captions)
    if(pip_vertex LESS 0 OR pip_fragment LESS 0 OR pip_captions LESS pip_fragment)
        message(FATAL_ERROR "PiP shader entry points changed; update extraction and pixel parity tests")
    endif()
    string(SUBSTRING "${pip_code}" 0 ${pip_vertex} pip_prefix)
    math(EXPR pip_start "${pip_fragment} + 17")
    math(EXPR pip_length "${pip_captions} - ${pip_start}")
    string(SUBSTRING "${pip_code}" ${pip_start} ${pip_length} pip_body)
    # Whole equirect/flat output already has the source's per-eye UV. Keep the
    # geometry flag for alignment wrapping, but avoid sin/cos -> atan/asin per pixel.
    string(REPLACE "vec2 shown_uv = eye_uv(pip_uv(UV), sample_direction);"
        "vec2 shown_uv = atlas_cached ? texture(atlas_projection, (UV * 1024.0 + 0.5) / 1025.0).rg : (atlas_main && video_geometry != 2 ? UV : eye_uv(pip_uv(UV), sample_direction)); if (atlas_make_map) { result = vec4(shown_uv, 0.0, 1.0); return; }" pip_body "${pip_body}")
    # Use the small numeric mask first. Fully transparent pixels need no colour,
    # sharpening or gamma work. Derivatives must be evaluated before that return.
    string(FIND "${pip_body}" "\tvec3 rgb =" pip_rgb_start)
    string(FIND "${pip_body}" "\t// The model input" pip_mask_start)
    string(FIND "${pip_body}" "\tALBEDO = outside_lens" pip_colour_start)
    string(FIND "${pip_body}" "\tif (packed_alpha &&" pip_alpha_start)
    string(FIND "${pip_body}" "\t// Crop correction borders" pip_trim_start)
    if(pip_rgb_start LESS 0 OR pip_mask_start LESS pip_rgb_start OR pip_colour_start LESS pip_mask_start
        OR pip_alpha_start LESS pip_colour_start OR pip_trim_start LESS pip_alpha_start)
        message(FATAL_ERROR "PiP colour/mask blocks changed; update extraction and pixel parity tests")
    endif()
    string(SUBSTRING "${pip_body}" 0 ${pip_rgb_start} pip_uv_body)
    math(EXPR pip_n "${pip_mask_start} - ${pip_rgb_start}")
    string(SUBSTRING "${pip_body}" ${pip_rgb_start} ${pip_n} pip_rgb_body)
    string(REPLACE "fwidth(color_p)" "atlas_footprint" pip_rgb_body "${pip_rgb_body}")
    math(EXPR pip_n "${pip_colour_start} - ${pip_mask_start}")
    string(SUBSTRING "${pip_body}" ${pip_mask_start} ${pip_n} pip_mask_body)
    math(EXPR pip_n "${pip_alpha_start} - ${pip_colour_start}")
    string(SUBSTRING "${pip_body}" ${pip_colour_start} ${pip_n} pip_colour_body)
    math(EXPR pip_n "${pip_trim_start} - ${pip_alpha_start}")
    string(SUBSTRING "${pip_body}" ${pip_alpha_start} ${pip_n} pip_alpha_body)
    string(SUBSTRING "${pip_body}" ${pip_trim_start} -1 pip_trim_body)
    set(pip_body "${pip_uv_body}\nvec2 atlas_footprint = fwidth(color_p);\n${pip_mask_body}${pip_alpha_body}\nif (ALPHA <= 0.0) { result = vec4(0.0); return; }\n${pip_rgb_body}${pip_colour_body}${pip_trim_body}")
    string(REGEX REPLACE "shader_type[^;]*;|render_mode[^;]*;|#include[^\n]*" "" pip_prefix "${pip_prefix}")
    # GLSL ES uniforms have no Godot sampler hints or default initializers. The JNI
    # request explicitly supplies every active uniform from the currently bound material.
    string(REGEX REPLACE "uniform ([A-Za-z0-9_]+) ([A-Za-z0-9_]+)[ \t]*[^;]*;" "uniform \\1 \\2;" pip_prefix "${pip_prefix}")
    string(REPLACE "varying flat int eye_index;" "int eye_index;" pip_prefix "${pip_prefix}")
    string(REPLACE "varying vec3 media_direction;" "vec3 media_direction;" pip_prefix "${pip_prefix}")
    string(REPLACE "outside_lens(sample_direction)" "(!atlas_cached && outside_lens(sample_direction))" pip_body "${pip_body}")
    string(REPLACE "ALBEDO" "pip_rgb" pip_body "${pip_body}")
    string(REPLACE "ALPHA" "pip_alpha" pip_body "${pip_body}")
    set(pip_extension "")
    if(pip_variant STREQUAL "video_rvm_pair_oes")
        set(pip_extension "#extension GL_OES_EGL_image_external_essl3 : require\n")
    endif()
    string(APPEND pip_sources "inline constexpr const char* ${pip_variant}_atlas = R\"PIP(#version 300 es\n${pip_extension}precision highp float;\nprecision highp int;\n#define PI 3.14159265358979323846\n#define TAU 6.28318530717958647692\n${pip_prefix}\nuniform vec2 atlas_origin; uniform vec2 atlas_size; uniform int atlas_eye; uniform bool atlas_raw; uniform bool atlas_main; uniform vec2 atlas_span; uniform bool atlas_make_map; uniform bool atlas_cached; uniform sampler2D atlas_projection;\nout vec4 result;\nvec3 atlas_linear(vec3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c)); }\nvec3 atlas_srgb(vec3 c) { return mix(c * 12.92, 1.055 * pow(max(c, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c)); }\nvoid main() {\nvec2 UV = atlas_make_map ? (gl_FragCoord.xy - 0.5) / 1024.0 : clamp((gl_FragCoord.xy - atlas_origin - (atlas_main ? vec2(0.0) : vec2(2.0))) / atlas_size, vec2(0.5) / atlas_size, vec2(1.0) - vec2(0.5) / atlas_size);\neye_index = atlas_eye; media_direction = vec3(0.0, 0.0, -1.0); if (atlas_main && video_geometry == 2 && !atlas_cached) { float longitude = (UV.x - 0.5) * atlas_span.x; float latitude = (0.5 - UV.y) * atlas_span.y; media_direction = vec3(cos(latitude) * sin(longitude), sin(latitude), -cos(latitude) * cos(longitude)); } vec3 pip_rgb; float pip_alpha;\n${pip_body}\nif (atlas_raw && pip_alpha >= 1.0) { result = vec4(pip_rgb, pip_alpha); return; }\nvec3 premultiplied = atlas_linear(pip_rgb) * pip_alpha;\nresult = vec4(atlas_raw ? atlas_srgb(premultiplied) : premultiplied, pip_alpha);\n}\n)PIP\";\n")
endforeach()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/pip_shader_sources.h" CONTENT "#pragma once\n${pip_sources}")
