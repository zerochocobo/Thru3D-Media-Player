 // Note: when reading interleaved subtitles, the demuxer won't try to forcibly
 // read ahead to get the next subtitle packet (as the next packet could be
 // minutes away). In this situation, this function will just return -1.
+// Consumer-side nonblocking drain of packets already queued by this demuxer.
+// Unlike the async reader's unthreaded path this must never call thread_work.
+int demux_read_packet_cached(struct sh_stream *sh, struct demux_packet **out_pkt)
+{
+    *out_pkt = NULL;
+    struct demux_stream *ds = sh ? sh->ds : NULL;
+    if (!ds)
+        return 0;
+    struct demux_internal *in = ds->in;
+    mp_mutex_lock(&in->lock);
+    int r = ds->reader_head && !ds->reader_head->is_cached
+        ? dequeue_packet(ds, MP_NOPTS_VALUE, out_pkt) : 0;
+    mp_mutex_unlock(&in->lock);
+    return r;
+}
+
 int demux_read_packet_async(struct sh_stream *sh, struct demux_packet **out_pkt)
 {
     return demux_read_packet_async_until(sh, MP_NOPTS_VALUE, out_pkt);
